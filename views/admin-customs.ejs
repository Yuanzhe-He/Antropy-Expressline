<%- include("partials/header", { pageTitle, currentPath, currentArea, currentModuleKey, currentModule, user, userRoleLabel, flash, lang, t, languageOptions, languageReturnTo, modules }) %>

<%
  const customsShippingLines = businessModuleRules.shippingLines || [];
  const customsPorts = businessModuleRules.ports || [];
  const customsYards = businessModuleRules.yards || [];
  const customsTerminalCount = customsPorts.reduce((sum, port) => sum + (port.terminals?.length || 0), 0);
  const customsLineYardMappingCount = customsShippingLines.reduce((sum, line) => sum + (line.yardIds?.length || 0), 0);
  const customsYardPortAssignmentCount = customsYards.reduce((sum, yard) => sum + (yard.portIds?.length || 0), 0);
  const customsYardLineAssignmentCount = customsYards.reduce((sum, yard) => sum + (yard.shippingLineIds?.length || 0), 0);
%>

<section class="hero-card hero-split">
  <div class="hero-copy">
    <p class="eyebrow"><%= t("admin.eyebrow") %></p>
    <h2><%= t("customs.adminTitle") %></h2>
    <p class="hero-text"><%= t("customs.adminDescription") %></p>
  </div>
  <div class="hero-side">
    <div class="status-tile">
      <span><%= t("common.status") %></span>
      <strong><%= selectedModule.stateLabel %></strong>
    </div>
    <div class="status-tile">
      <span><%= t("customs.dataCoverage") %></span>
      <strong><%= businessModuleRules.ports.length %> <%= t("customs.portLabel") %> / <%= businessModuleRules.yards.length %> <%= t("customs.yardLabel") %></strong>
    </div>
  </div>
</section>

<%- include("partials/admin-tabs", { modules, currentModuleKey, currentAdminSection, t }) %>

<form
  method="post"
  action="/admin/customs/shipping-lines"
  class="stack-form"
  data-admin-form
  data-unsaved-label="<%= t("admin.unsavedChanges") %>"
  data-saved-label="<%= t("admin.savedState") %>"
  data-confirm-leave="<%= t("admin.confirmLeave") %>"
>
  <section class="cards-grid">
    <article class="summary-card">
      <p><%= t("admin.shippingLineTable") %></p>
      <strong><%= customsShippingLines.length %></strong>
    </article>
    <article class="summary-card">
      <p><%= t("customs.portLabel") %></p>
      <strong><%= customsPorts.length %></strong>
    </article>
    <article class="summary-card">
      <p><%= t("customs.terminalLabel") %></p>
      <strong><%= customsTerminalCount %></strong>
    </article>
    <article class="summary-card">
      <p><%= t("customs.yardLabel") %></p>
      <strong><%= customsYards.length %></strong>
    </article>
  </section>

  <nav class="section-jump-nav" aria-label="<%= t("admin.jumpToSection") %>">
    <span><%= t("admin.jumpToSection") %></span>
    <a href="#customs-yard-map"><%= t("customs.shippingLineYardMap") %></a>
    <a href="#customs-terminal-rules"><%= t("customs.portTerminalRules") %></a>
    <a href="#customs-yard-rules"><%= t("customs.yardRulesTitle") %></a>
  </nav>

  <section class="panel" id="customs-yard-map">
    <div class="section-title">
      <div>
        <p class="eyebrow"><%= t("customs.shippingLineYardMap") %></p>
        <h3><%= t("customs.shippingLineYardMapDescription") %></h3>
      </div>
    </div>
    <details class="table-card hierarchy-card entity-collapsible">
      <summary class="collapsible-summary hierarchy-summary">
        <div>
          <h4><%= t("customs.shippingLineGroupSummary", { count: customsShippingLines.length }) %></h4>
        </div>
        <div class="collapsible-summary-actions">
          <span class="selected-state-indicator"><%= t("admin.currentSelection") %></span>
          <span class="collapsible-summary-meta"><%= t("customs.yardMappingTotal", { count: customsLineYardMappingCount }) %></span>
        </div>
      </summary>

      <div class="entity-collapsible-body hierarchy-card-body">
        <div class="stack-form line-yard-map-list">
          <% for (const line of customsShippingLines) { %>
            <details class="table-card nested-card entity-collapsible line-yard-map-card" id="customs-line-yard-map-<%= line.id %>" data-line-yard-map-card>
              <summary class="collapsible-summary">
                <div>
                  <p class="eyebrow"><%= t("customs.shippingLineLabel") %></p>
                  <h4><%= line.name %></h4>
                </div>
                <div class="collapsible-summary-actions">
                  <span class="selected-state-indicator"><%= t("admin.currentSelection") %></span>
                  <span class="collapsible-summary-meta"><%= t("customs.yardMappingCount", { count: (line.yardIds || []).length }) %></span>
                </div>
              </summary>

              <div class="entity-collapsible-body">
                <div class="grid-form">
                  <label>
                    <span><%= t("common.note") %></span>
                    <input type="text" name="customs_line_note_<%= line.id %>" value="<%= line.notes || '' %>" />
                  </label>
                  <label>
                    <span><%= t("customs.availableYards") %></span>
                    <select name="shippingLine_yardIds_<%= line.id %>" multiple size="<%= Math.min(6, Math.max(3, customsYards.length)) %>">
                      <% for (const yard of customsYards) { %>
                        <option value="<%= yard.id %>" <%= line.yardIds?.includes(yard.id) ? "selected" : "" %>>
                          <%= yard.name %>
                        </option>
                      <% } %>
                    </select>
                  </label>
                </div>
              </div>
            </details>
          <% } %>
        </div>
      </div>
    </details>
  </section>

  <section class="panel" id="customs-terminal-rules">
    <div class="section-title">
      <div>
        <p class="eyebrow"><%= t("customs.portTerminalRules") %></p>
        <h3><%= t("customs.portTerminalRulesDescription") %></h3>
      </div>
      <button
        type="submit"
        class="ghost-button compact-button"
        formaction="/admin/customs/ports/add"
        formmethod="post"
      ><%= t("customs.addPort") %></button>
    </div>

    <details class="table-card hierarchy-card entity-collapsible">
      <summary class="collapsible-summary hierarchy-summary">
        <div>
          <h4><%= t("customs.terminalGroupSummary", { count: customsTerminalCount }) %></h4>
        </div>
        <div class="collapsible-summary-actions">
          <span class="selected-state-indicator"><%= t("admin.currentSelection") %></span>
          <span class="collapsible-summary-meta"><%= t("customs.portGroupSummary", { count: customsPorts.length }) %></span>
        </div>
      </summary>

      <div class="entity-collapsible-body hierarchy-card-body">
        <div class="stack-form">
          <% for (const port of customsPorts) { %>
            <details class="table-card nested-card entity-collapsible port-group-card" id="customs-port-<%= port.id %>">
              <summary class="collapsible-summary">
                <div>
                  <p class="eyebrow"><%= t("customs.portLabel") %></p>
                  <h4><%= port.name %></h4>
                </div>
                <div class="collapsible-summary-actions">
                  <span class="selected-state-indicator"><%= t("admin.currentSelection") %></span>
                  <span class="collapsible-summary-meta"><%= t("customs.portTerminalCount", { count: (port.terminals || []).length }) %></span>
                  <button
                    type="submit"
                    class="ghost-button compact-button danger-button"
                    formaction="/admin/customs/ports/<%= port.id %>/delete"
                    formmethod="post"
                    data-summary-action
                    data-preserve-scroll
                    data-confirm-submit="<%= t('customs.confirmDeletePort') %>"
                  ><%= t("customs.deletePort") %></button>
                </div>
              </summary>

              <div class="entity-collapsible-body">
                <div class="grid-form">
                  <label>
                    <span><%= t("customs.portLabel") %></span>
                    <input type="text" name="port_name_<%= port.id %>" value="<%= port.name %>" />
                  </label>
                  <label class="full-width">
                    <span><%= t("common.note") %></span>
                    <input type="text" name="port_note_<%= port.id %>" value="<%= port.note || '' %>" />
                  </label>
                </div>

                <div class="actions">
                  <button
                    type="submit"
                    class="ghost-button compact-button"
                    formaction="/admin/customs/ports/<%= port.id %>/terminals/add"
                    formmethod="post"
                  ><%= t("customs.addTerminal") %></button>
                </div>

                <% for (const terminal of port.terminals || []) { %>
                  <details class="table-card nested-card entity-collapsible" id="customs-terminal-<%= terminal.id %>">
              <summary class="collapsible-summary">
                <div>
                  <p class="eyebrow"><%= t("customs.terminalLabel") %></p>
                  <h4><%= terminal.name %></h4>
                </div>
                <div class="collapsible-summary-actions">
                  <span class="selected-state-indicator"><%= t("admin.currentSelection") %></span>
                  <span class="collapsible-summary-meta"><%= (terminal.storageRuleSets || []).length %> <%= t("customs.storageRuleSetLabel") %></span>
                  <button
                    type="submit"
                    class="ghost-button compact-button danger-button"
                    formaction="/admin/customs/terminals/<%= terminal.id %>/delete"
                    formmethod="post"
                    data-summary-action
                    data-preserve-scroll
                    data-confirm-submit="<%= t("customs.confirmDeleteTerminal", { count: (terminal.storageRuleSets || []).length }) %>"
                  ><%= t("customs.deleteTerminal") %></button>
                </div>
              </summary>

              <div class="entity-collapsible-body">
                <div class="grid-form">
                  <label>
                    <span><%= t("customs.terminalLabel") %></span>
                    <input type="text" name="terminal_name_<%= terminal.id %>" value="<%= terminal.name %>" />
                  </label>
                  <label class="full-width">
                    <span><%= t("common.note") %></span>
                    <input type="text" name="terminal_note_<%= terminal.id %>" value="<%= terminal.note || '' %>" />
                  </label>
                </div>

                <div class="table-card nested-card">
                  <div class="section-title compact">
                    <div>
                      <p class="eyebrow"><%= t("customs.categories.terminalFixed") %></p>
                      <h4><%= t("customs.fixedFeeTable") %></h4>
                    </div>
                    <%# B2 (QA): add a fixed charge row. %>
                    <button type="submit" class="ghost-button compact-button"
                      formaction="/admin/customs/terminals/<%= terminal.id %>/fixed-charges/add"
                      formmethod="post" data-preserve-scroll
                    ><%= t("customs.addFixedCharge") %></button>
                  </div>
                  <table>
                    <thead>
                      <tr>
                        <th><%= t("admin.item") %></th>
                        <th><%= t("common.note") %></th>
                        <th><%= t("admin.taxRate") %></th>
                        <th><%= t("customs.chargeRequired") %></th>
                        <th><%= t("customs.chargeBasis") %></th>
                        <th><%= t("customs.chargeAmount") %></th>
                        <% for (const type of businessModuleRules.containerTypes || []) { %>
                          <th><%= type.label %></th>
                        <% } %>
                        <th><%= t("admin.actions") %></th>
                      </tr>
                    </thead>
                    <tbody>
                      <% for (const charge of terminal.fixedCharges || []) { %>
                        <tr>
                          <td><input type="text" name="terminal_charge_concept_<%= terminal.id %>_<%= charge.id %>" value="<%= charge.concept %>" /></td>
                          <td><input type="text" name="terminal_charge_note_<%= terminal.id %>_<%= charge.id %>" value="<%= charge.note || '' %>" /></td>
                          <td>
                            <select name="terminal_charge_tax_<%= terminal.id %>_<%= charge.id %>">
                              <% for (const preset of businessModuleRules.taxRatePresets || []) { %>
                                <option value="<%= preset.rate %>" <%= String(charge.taxRate) === String(preset.rate) ? "selected" : "" %>>
                                  <%= preset.label %>
                                </option>
                              <% } %>
                            </select>
                          </td>
                          <td style="text-align:center;">
                            <input type="checkbox" name="terminal_charge_<%= terminal.id %>_<%= charge.id %>_required" <%= charge.required ? "checked" : "" %> title="<%= t('customs.chargeRequiredHelp') %>" />
                          </td>
                          <td>
                            <select name="terminal_charge_<%= terminal.id %>_<%= charge.id %>_basis">
                              <option value="per_occurrence" <%= charge.basis !== "per_day" ? "selected" : "" %>><%= t("customs.basisPerOccurrence") %></option>
                              <option value="per_day" <%= charge.basis === "per_day" ? "selected" : "" %>><%= t("customs.basisPerDay") %></option>
                            </select>
                          </td>
                          <td>
                            <div class="rate-cell">
                              <input type="number" min="0" step="0.01" name="terminal_charge_<%= terminal.id %>_<%= charge.id %>_amount" value="<%= charge.amount == null ? '' : charge.amount %>" placeholder="—" />
                              <select name="terminal_charge_<%= terminal.id %>_<%= charge.id %>_amountCurrency">
                                <% for (const option of currencyOptions) { %>
                                  <option value="<%= option.code %>" <%= (charge.amountCurrency || 'MXN') === option.code ? "selected" : "" %>><%= option.label %></option>
                                <% } %>
                              </select>
                            </div>
                          </td>
                          <% for (const type of businessModuleRules.containerTypes || []) { %>
                            <% const rate = charge.groupRates?.[type.key]; %>
                            <td>
                              <div class="rate-cell">
                                <input type="number" min="0" step="0.01" name="terminal_charge_<%= terminal.id %>_<%= charge.id %>_<%= type.key %>_rate" value="<%= rate?.rate ?? 0 %>" />
                                <select name="terminal_charge_<%= terminal.id %>_<%= charge.id %>_<%= type.key %>_currency">
                                  <% for (const option of currencyOptions) { %>
                                    <option value="<%= option.code %>" <%= rate?.currency === option.code ? "selected" : "" %>>
                                      <%= option.label %>
                                    </option>
                                  <% } %>
                                </select>
                              </div>
                            </td>
                          <% } %>
                          <td>
                            <button type="submit" class="ghost-button compact-button danger-button"
                              formaction="/admin/customs/terminals/<%= terminal.id %>/fixed-charges/<%= charge.id %>/delete"
                              formmethod="post" data-preserve-scroll
                              data-confirm-submit="<%= t('customs.confirmDeleteFixedCharge') %>"
                            ><%= t("customs.deleteFixedCharge") %></button>
                          </td>
                        </tr>
                      <% } %>
                    </tbody>
                  </table>
                </div>

                <div class="table-card nested-card storage-rule-set-shell">
                  <div class="section-title compact">
                    <div>
                      <p class="eyebrow"><%= t("customs.categories.terminalStorage") %></p>
                      <h4><%= t("customs.storageRuleSetsTitle") %></h4>
                      <p class="helper-text"><%= t("customs.storageRuleSetsDescription") %></p>
                    </div>
                    <button
                      type="submit"
                      class="ghost-button compact-button"
                      formaction="/admin/customs/terminals/<%= terminal.id %>/storage-rule-sets/add"
                      formmethod="post"
                      data-preserve-scroll
                    ><%= t("admin.addRuleSet") %></button>
                  </div>

                  <% for (const ruleSet of terminal.storageRuleSets || []) { %>
                    <% const selectedLineContainerAssignments = []; %>
                    <% const blockedLineContainerAssignments = []; %>
                    <% for (const line of businessModuleRules.shippingLines || []) { %>
                      <% for (const type of businessModuleRules.containerTypes || []) { %>
                        <% const assignmentKey = `${line.id}::${type.key}`; %>
                        <% const isUnassignedAssignment = (terminal.storageUnassignedLineContainers || []).includes(assignmentKey); %>
                        <% const assignedRuleSetId = isUnassignedAssignment ? null : (terminal.storageAssignmentsByLineContainer?.[line.id]?.[type.key] || terminal.storageAssignmentsByContainerType?.[type.key] || null); %>
                        <% if (assignedRuleSetId === ruleSet.id) { selectedLineContainerAssignments.push({ line, type }); } %>
                        <% if (assignedRuleSetId && assignedRuleSetId !== ruleSet.id) { %>
                          <% const assignedRuleSet = (terminal.storageRuleSets || []).find((entry) => entry.id === assignedRuleSetId); %>
                          <% blockedLineContainerAssignments.push({ line, type, ruleSetName: assignedRuleSet?.name || assignedRuleSetId }); %>
                        <% } %>
                      <% } %>
                    <% } %>
                    <details
                      class="table-card nested-card storage-rule-card entity-collapsible"
                      id="customs-storage-rule-<%= terminal.id %>-<%= ruleSet.id %>"
                      data-storage-rule-card
                      data-default-container-key="<%= ruleSet.sourceContainerKey || '' %>"
                    >
                      <summary class="collapsible-summary storage-rule-summary">
                        <div>
                          <p class="eyebrow"><%= t("customs.storageRuleSetLabel") %></p>
                          <h4><%= ruleSet.name %></h4>
                        </div>
                        <div class="collapsible-summary-actions">
                          <span class="selected-state-indicator"><%= t("admin.currentSelection") %></span>
                          <span class="collapsible-summary-meta"><%= t("customs.assignmentCount", { count: selectedLineContainerAssignments.length }) %></span>
                          <button
                            type="submit"
                            class="ghost-button compact-button danger-button"
                            formaction="/admin/customs/terminals/<%= terminal.id %>/storage-rule-sets/<%= ruleSet.id %>/delete"
                            formmethod="post"
                            data-summary-action
                            data-preserve-scroll
                            data-confirm-submit="<%= t("customs.confirmDeleteStorageRuleSet", { count: selectedLineContainerAssignments.length }) %>"
                            <%= (terminal.storageRuleSets || []).length <= 1 ? "disabled" : "" %>
                          ><%= t("customs.deleteStorageRuleSet") %></button>
                        </div>
                      </summary>

                      <div class="entity-collapsible-body">
                        <div class="section-title compact">
                          <label class="rule-name-field">
                            <span><%= t("admin.ruleSetName") %></span>
                            <input type="text" name="terminal_storage_set_<%= terminal.id %>_<%= ruleSet.id %>_name" value="<%= ruleSet.name %>" />
                          </label>
                        <div class="rule-card-actions">
                          <button
                            type="submit"
                            class="ghost-button compact-button"
                            formaction="/admin/customs/terminals/<%= terminal.id %>/storage-rule-sets/<%= ruleSet.id %>/add"
                            formmethod="post"
                            data-preserve-scroll
                          ><%= t("admin.addRule") %></button>
                        </div>
                      </div>
                      <div class="assignment-toolbar" data-storage-assignment-tools>
                        <button type="button" class="ghost-button compact-button" data-storage-select="same-container"><%= t("customs.selectSameContainerLines") %></button>
                        <button type="button" class="ghost-button compact-button" data-storage-select="available"><%= t("customs.selectAvailableAssignments") %></button>
                        <button type="button" class="ghost-button compact-button" data-storage-select="clear"><%= t("customs.clearRuleAssignments") %></button>
                      </div>
                      <div class="assignment-picker-layout">
                        <label class="rule-assignment-field line-container-assignment-field" data-storage-assignment-group>
                          <span><%= t("customs.assignedLineContainers") %></span>
                          <select
                            name="terminal_storage_set_<%= terminal.id %>_<%= ruleSet.id %>_lineContainers"
                            multiple
                            size="<%= Math.min(12, Math.max(5, businessModuleRules.shippingLines.length)) %>"
                            data-storage-assignment-select
                          >
                            <% for (const line of businessModuleRules.shippingLines || []) { %>
                              <optgroup label="<%= line.name %>">
                                <% for (const type of businessModuleRules.containerTypes || []) { %>
                                  <% const assignmentKey = `${line.id}::${type.key}`; %>
                                  <% const isUnassignedAssignment = (terminal.storageUnassignedLineContainers || []).includes(assignmentKey); %>
                                  <% const assignedRuleSetId = isUnassignedAssignment ? null : (terminal.storageAssignmentsByLineContainer?.[line.id]?.[type.key] || terminal.storageAssignmentsByContainerType?.[type.key] || null); %>
                                  <% const isSelectedAssignment = assignedRuleSetId === ruleSet.id; %>
                                  <% const isDisabledAssignment = assignedRuleSetId && assignedRuleSetId !== ruleSet.id; %>
                                  <% const assignedRuleSet = isDisabledAssignment ? (terminal.storageRuleSets || []).find((entry) => entry.id === assignedRuleSetId) : null; %>
                                  <option
                                    value="<%= assignmentKey %>"
                                    data-line-id="<%= line.id %>"
                                    data-container-key="<%= type.key %>"
                                    <%= isSelectedAssignment ? "selected" : "" %>
                                    <%= isDisabledAssignment ? "disabled" : "" %>
                                  >
                                    <%= line.name %> / <%= type.label %><%= assignedRuleSet ? ` - ${t("customs.assignmentOccupiedBy", { name: assignedRuleSet.name })}` : "" %>
                                  </option>
                                <% } %>
                              </optgroup>
                            <% } %>
                          </select>
                        </label>
                        <% if (blockedLineContainerAssignments.length) { %>
                          <div class="blocked-assignment-panel" data-storage-blocked-assignments>
                            <label class="release-assignment-field">
                              <span class="field-label"><%= t("customs.occupiedAssignmentsTitle") %></span>
                              <select name="releaseLineContainerKey_<%= ruleSet.id %>" data-storage-release-select>
                                <option value=""><%= t("customs.selectOccupiedAssignment") %></option>
                              </select>
                            </label>
                            <div class="release-assignment-actions">
                              <p class="helper-text"><%= t("customs.occupiedAssignmentsHint") %></p>
                              <button
                                type="submit"
                                class="ghost-button compact-button"
                                name="releaseRuleSetId"
                                value="<%= ruleSet.id %>"
                                formaction="/admin/customs/terminals/<%= terminal.id %>/storage-assignments/release"
                                formmethod="post"
                                data-storage-release-assignment
                                data-storage-release-button
                                data-preserve-scroll
                                disabled
                              ><%= t("customs.releaseStorageAssignment") %></button>
                            </div>
                          </div>
                        <% } %>
                      </div>
                      <% if (selectedLineContainerAssignments.length) { %>
                        <div class="selected-assignment-list">
                          <% for (const assignment of selectedLineContainerAssignments) { %>
                            <span class="assignment-pill">
                              <span><%= assignment.line.name %> / <%= assignment.type.label %></span>
                              <button
                                type="submit"
                                class="ghost-button compact-button"
                                formaction="/admin/customs/terminals/<%= terminal.id %>/storage-assignments/<%= assignment.line.id %>/<%= assignment.type.key %>/delete?returnRuleSetId=<%= ruleSet.id %>"
                                formmethod="post"
                                data-preserve-scroll
                              ><%= t("customs.removeStorageAssignment") %></button>
                            </span>
                          <% } %>
                        </div>
                      <% } %>
                      <table class="compact-rule-table">
                        <thead>
                          <tr>
                            <th><%= t("admin.startDay") %></th>
                            <th><%= t("admin.endDay") %></th>
                            <th><%= t("admin.taxRate") %></th>
                            <th><%= t("admin.amount") %></th>
                            <th><%= t("admin.currency") %></th>
                            <th><%= t("admin.actions") %></th>
                          </tr>
                        </thead>
                        <tbody>
                          <% for (const rule of ruleSet.rules || []) { %>
                            <tr>
                              <td><input type="number" value="<%= rule.startDay ?? '' %>" readonly /></td>
                              <td>
                                <input
                                  type="number"
                                  min="0"
                                  step="1"
                                  name="terminal_storage_set_<%= terminal.id %>_<%= ruleSet.id %>_<%= rule.id %>_end"
                                  value="<%= rule.endDay ?? '' %>"
                                  placeholder="<%= t("customs.autoRangeHint") %>"
                                />
                              </td>
                              <td>
                                <select name="terminal_storage_set_<%= terminal.id %>_<%= ruleSet.id %>_<%= rule.id %>_tax">
                                  <% for (const preset of businessModuleRules.taxRatePresets || []) { %>
                                    <option value="<%= preset.rate %>" <%= String(rule.taxRate) === String(preset.rate) ? "selected" : "" %>>
                                      <%= preset.label %>
                                    </option>
                                  <% } %>
                                </select>
                              </td>
                              <td><input type="number" min="0" step="0.01" name="terminal_storage_set_<%= terminal.id %>_<%= ruleSet.id %>_<%= rule.id %>_rate" value="<%= rule.rateConfig?.rate ?? 0 %>" /></td>
                              <td>
                                <select name="terminal_storage_set_<%= terminal.id %>_<%= ruleSet.id %>_<%= rule.id %>_currency">
                                  <% for (const option of currencyOptions) { %>
                                    <option value="<%= option.code %>" <%= rule.rateConfig?.currency === option.code ? "selected" : "" %>>
                                      <%= option.label %>
                                    </option>
                                  <% } %>
                                </select>
                              </td>
                              <td>
                                <button
                                  type="submit"
                                  class="ghost-button compact-button"
                                  formaction="/admin/customs/terminals/<%= terminal.id %>/storage-rule-sets/<%= ruleSet.id %>/<%= rule.id %>/delete"
                                  formmethod="post"
                                  data-preserve-scroll
                                  data-confirm-submit="<%= t("admin.confirmDeleteRule") %>"
                                  <%= (ruleSet.rules || []).length <= 1 ? "disabled" : "" %>
                                ><%= t("admin.deleteRule") %></button>
                              </td>
                            </tr>
                          <% } %>
                        </tbody>
                      </table>
                      <p class="helper-text"><%= t("admin.autoSequentialHint") %></p>
                      </div>
                    </details>
                  <% } %>
                </div>
              </div>
            </details>
          <% } %>
              </div>
            </details>
          <% } %>
        </div>
      </div>
    </details>
  </section>

  <section class="panel" id="customs-yard-rules">
    <div class="section-title">
      <div>
        <p class="eyebrow"><%= t("customs.yardRulesTitle") %></p>
        <h3><%= t("customs.yardRulesDescription") %></h3>
      </div>
      <button
        type="submit"
        class="ghost-button compact-button"
        formaction="/admin/customs/yards/add"
        formmethod="post"
      ><%= t("customs.addYard") %></button>
    </div>

    <details class="table-card hierarchy-card entity-collapsible">
      <summary class="collapsible-summary hierarchy-summary">
        <div>
          <h4><%= t("customs.yardGroupSummary", { count: customsYards.length }) %></h4>
        </div>
        <div class="collapsible-summary-actions">
          <span class="selected-state-indicator"><%= t("admin.currentSelection") %></span>
          <span class="collapsible-summary-meta"><%= t("customs.yardGroupMeta", { ports: customsYardPortAssignmentCount, lines: customsYardLineAssignmentCount }) %></span>
        </div>
      </summary>

      <div class="entity-collapsible-body hierarchy-card-body">
        <div class="stack-form">
          <% for (const yard of customsYards) { %>
            <details class="table-card nested-card entity-collapsible" id="customs-yard-<%= yard.id %>">
              <summary class="collapsible-summary">
                <div>
                  <p class="eyebrow"><%= t("customs.yardLabel") %></p>
                  <h4><%= yard.name %></h4>
                </div>
                <div class="collapsible-summary-actions">
                  <span class="selected-state-indicator"><%= t("admin.currentSelection") %></span>
                  <span class="collapsible-summary-meta"><%= (yard.portIds || []).length %> <%= t("customs.portLabel") %> / <%= (yard.shippingLineIds || []).length %> <%= t("customs.shippingLineLabel") %></span>
                  <button
                    type="submit"
                    class="ghost-button compact-button danger-button"
                    formaction="/admin/customs/yards/<%= yard.id %>/delete"
                    formmethod="post"
                    data-summary-action
                    data-preserve-scroll
                    data-confirm-submit="<%= t("customs.confirmDeleteYard", { ports: (yard.portIds || []).length, lines: (yard.shippingLineIds || []).length }) %>"
                  ><%= t("customs.deleteYard") %></button>
                </div>
              </summary>

              <div class="entity-collapsible-body">
                <div class="grid-form">
                  <label>
                    <span><%= t("customs.yardLabel") %></span>
                    <input type="text" name="yard_name_<%= yard.id %>" value="<%= yard.name %>" />
                  </label>
                  <label class="full-width">
                    <span><%= t("common.note") %></span>
                    <input type="text" name="yard_note_<%= yard.id %>" value="<%= yard.note || '' %>" />
                  </label>
                  <label>
                    <span><%= t("customs.portLabel") %></span>
                    <select name="yard_portIds_<%= yard.id %>" multiple size="<%= Math.min(5, Math.max(2, customsPorts.length)) %>">
                      <% for (const port of customsPorts) { %>
                        <option value="<%= port.id %>" <%= yard.portIds?.includes(port.id) ? "selected" : "" %>>
                          <%= port.name %>
                        </option>
                      <% } %>
                    </select>
                  </label>
                  <label>
                    <span><%= t("customs.shippingLineLabel") %></span>
                    <select name="yard_shippingLineIds_<%= yard.id %>" multiple size="<%= Math.min(6, Math.max(3, customsShippingLines.length)) %>">
                      <% for (const line of customsShippingLines) { %>
                        <option value="<%= line.id %>" <%= yard.shippingLineIds?.includes(line.id) ? "selected" : "" %>>
                          <%= line.name %>
                        </option>
                      <% } %>
                    </select>
                  </label>
                </div>

            <% for (const chargeGroup of [
              { list: yard.dropoffCharges, prefix: "yard_dropoff", key: "customs.categories.yardDropoff", title: t("customs.dropoffFeeTable") },
              { list: yard.customsCharges, prefix: "yard_customs", key: "customs.categories.yardCustoms", title: t("customs.customsFeeTable") },
            ]) { %>
              <div class="table-card nested-card">
                <div class="section-title compact">
                  <div>
                    <p class="eyebrow"><%= t(chargeGroup.key) %></p>
                    <h4><%= chargeGroup.title %></h4>
                  </div>
                </div>
                <table>
                  <thead>
                    <tr>
                      <th><%= t("admin.item") %></th>
                      <th><%= t("common.note") %></th>
                      <th><%= t("admin.taxRate") %></th>
                      <% for (const type of businessModuleRules.containerTypes || []) { %>
                        <th><%= type.label %></th>
                      <% } %>
                    </tr>
                  </thead>
                  <tbody>
                    <% for (const charge of chargeGroup.list || []) { %>
                      <tr>
                        <td><input type="text" name="<%= chargeGroup.prefix %>_concept_<%= yard.id %>_<%= charge.id %>" value="<%= charge.concept %>" /></td>
                        <td><input type="text" name="<%= chargeGroup.prefix %>_note_<%= yard.id %>_<%= charge.id %>" value="<%= charge.note || '' %>" /></td>
                        <td>
                          <select name="<%= chargeGroup.prefix %>_tax_<%= yard.id %>_<%= charge.id %>">
                            <% for (const preset of businessModuleRules.taxRatePresets || []) { %>
                              <option value="<%= preset.rate %>" <%= String(charge.taxRate) === String(preset.rate) ? "selected" : "" %>>
                                <%= preset.label %>
                              </option>
                            <% } %>
                          </select>
                        </td>
                        <% for (const type of businessModuleRules.containerTypes || []) { %>
                          <% const rate = charge.groupRates?.[type.key]; %>
                          <td>
                            <div class="rate-cell">
                              <input type="number" min="0" step="0.01" name="<%= chargeGroup.prefix %>_<%= yard.id %>_<%= charge.id %>_<%= type.key %>_rate" value="<%= rate?.rate ?? 0 %>" />
                              <select name="<%= chargeGroup.prefix %>_<%= yard.id %>_<%= charge.id %>_<%= type.key %>_currency">
                                <% for (const option of currencyOptions) { %>
                                  <option value="<%= option.code %>" <%= rate?.currency === option.code ? "selected" : "" %>>
                                    <%= option.label %>
                                  </option>
                                <% } %>
                              </select>
                            </div>
                          </td>
                        <% } %>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
        </details>
          <% } %>
        </div>
      </div>
    </details>
  </section>

  <div class="actions sticky-save-bar">
    <span class="save-state" data-save-state><%= t("admin.savedState") %></span>
    <button type="button" class="ghost-button compact-button" data-discard-changes disabled><%= t("admin.discardChanges") %></button>
    <button type="submit"><%= t("admin.saveShippingLine") %></button>
  </div>
</form>

<%- include("partials/footer") %>
