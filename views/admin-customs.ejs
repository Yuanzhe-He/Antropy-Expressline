<%- include("partials/header", { pageTitle, currentPath, currentArea, currentModuleKey, currentModule, user, userRoleLabel, flash, lang, t, languageOptions, languageReturnTo, modules }) %>

<section class="hero-card hero-split">
  <div class="hero-copy">
    <p class="eyebrow"><%= t("admin.eyebrow") %></p>
    <h2><%= t("customs.adminTitle") %></h2>
    <p class="hero-text"><%= t("customs.adminDescription") %></p>
  </div>
  <div class="hero-side">
    <div class="status-tile">
      <span><%= t("common.status") %></span>
      <strong><%= selectedModule.stateLabel %></strong>
    </div>
    <div class="status-tile">
      <span><%= t("customs.dataCoverage") %></span>
      <strong><%= businessModuleRules.ports.length %> <%= t("customs.portLabel") %> / <%= businessModuleRules.yards.length %> <%= t("customs.yardLabel") %></strong>
    </div>
  </div>
</section>

<%- include("partials/admin-tabs", { modules, currentModuleKey, currentAdminSection, t }) %>

<form method="post" action="/admin/customs/shipping-lines" class="stack-form">
  <section class="cards-grid">
    <article class="summary-card">
      <p><%= t("admin.shippingLineTable") %></p>
      <strong><%= businessModuleRules.shippingLines.length %></strong>
    </article>
    <article class="summary-card">
      <p><%= t("customs.portLabel") %></p>
      <strong><%= businessModuleRules.ports.length %></strong>
    </article>
    <article class="summary-card">
      <p><%= t("customs.terminalLabel") %></p>
      <strong><%= businessModuleRules.ports.reduce((sum, port) => sum + (port.terminals?.length || 0), 0) %></strong>
    </article>
    <article class="summary-card">
      <p><%= t("customs.yardLabel") %></p>
      <strong><%= businessModuleRules.yards.length %></strong>
    </article>
  </section>

  <section class="panel">
    <div class="section-title">
      <div>
        <p class="eyebrow"><%= t("customs.shippingLineYardMap") %></p>
        <h3><%= t("customs.shippingLineYardMapDescription") %></h3>
      </div>
    </div>
    <div class="table-card">
      <table>
        <thead>
          <tr>
            <th><%= t("customs.shippingLineLabel") %></th>
            <th><%= t("common.note") %></th>
            <th><%= t("customs.availableYards") %></th>
          </tr>
        </thead>
        <tbody>
          <% for (const line of businessModuleRules.shippingLines || []) { %>
            <tr>
              <td><strong><%= line.name %></strong></td>
              <td><input type="text" name="customs_line_note_<%= line.id %>" value="<%= line.notes || '' %>" /></td>
              <td>
                <select name="shippingLine_yardIds_<%= line.id %>" multiple size="<%= Math.min(6, Math.max(3, businessModuleRules.yards.length)) %>">
                  <% for (const yard of businessModuleRules.yards || []) { %>
                    <option value="<%= yard.id %>" <%= line.yardIds?.includes(yard.id) ? "selected" : "" %>>
                      <%= yard.name %>
                    </option>
                  <% } %>
                </select>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="panel">
    <div class="section-title">
      <div>
        <p class="eyebrow"><%= t("customs.portTerminalRules") %></p>
        <h3><%= t("customs.portTerminalRulesDescription") %></h3>
      </div>
    </div>

    <div class="stack-form">
      <% for (const port of businessModuleRules.ports || []) { %>
        <article class="table-card nested-card">
          <div class="section-title compact">
            <div>
              <p class="eyebrow"><%= t("customs.portLabel") %></p>
              <h4><%= port.name %></h4>
            </div>
          </div>

          <div class="grid-form">
            <label>
              <span><%= t("customs.portLabel") %></span>
              <input type="text" name="port_name_<%= port.id %>" value="<%= port.name %>" />
            </label>
            <label class="full-width">
              <span><%= t("common.note") %></span>
              <input type="text" name="port_note_<%= port.id %>" value="<%= port.note || '' %>" />
            </label>
          </div>

          <% for (const terminal of port.terminals || []) { %>
            <div class="table-card nested-card">
              <div class="section-title compact">
                <div>
                  <p class="eyebrow"><%= t("customs.terminalLabel") %></p>
                  <h4><%= terminal.name %></h4>
                </div>
              </div>

              <div class="grid-form">
                <label>
                  <span><%= t("customs.terminalLabel") %></span>
                  <input type="text" name="terminal_name_<%= terminal.id %>" value="<%= terminal.name %>" />
                </label>
                <label class="full-width">
                  <span><%= t("common.note") %></span>
                  <input type="text" name="terminal_note_<%= terminal.id %>" value="<%= terminal.note || '' %>" />
                </label>
              </div>

              <div class="table-card nested-card">
                <div class="section-title compact">
                  <div>
                    <p class="eyebrow"><%= t("customs.categories.terminalFixed") %></p>
                    <h4><%= t("customs.fixedFeeTable") %></h4>
                  </div>
                </div>
                <table>
                  <thead>
                    <tr>
                      <th><%= t("admin.item") %></th>
                      <th><%= t("common.note") %></th>
                      <th><%= t("admin.taxRate") %></th>
                      <% for (const type of businessModuleRules.containerTypes || []) { %>
                        <th><%= type.label %></th>
                      <% } %>
                    </tr>
                  </thead>
                  <tbody>
                    <% for (const charge of terminal.fixedCharges || []) { %>
                      <tr>
                        <td><input type="text" name="terminal_charge_concept_<%= terminal.id %>_<%= charge.id %>" value="<%= charge.concept %>" /></td>
                        <td><input type="text" name="terminal_charge_note_<%= terminal.id %>_<%= charge.id %>" value="<%= charge.note || '' %>" /></td>
                        <td>
                          <select name="terminal_charge_tax_<%= terminal.id %>_<%= charge.id %>">
                            <% for (const preset of businessModuleRules.taxRatePresets || []) { %>
                              <option value="<%= preset.rate %>" <%= String(charge.taxRate) === String(preset.rate) ? "selected" : "" %>>
                                <%= preset.label %>
                              </option>
                            <% } %>
                          </select>
                        </td>
                        <% for (const type of businessModuleRules.containerTypes || []) { %>
                          <% const rate = charge.groupRates?.[type.key]; %>
                          <td>
                            <div class="rate-cell">
                              <input type="number" min="0" step="0.01" name="terminal_charge_<%= terminal.id %>_<%= charge.id %>_<%= type.key %>_rate" value="<%= rate?.rate ?? 0 %>" />
                              <select name="terminal_charge_<%= terminal.id %>_<%= charge.id %>_<%= type.key %>_currency">
                                <% for (const option of currencyOptions) { %>
                                  <option value="<%= option.code %>" <%= rate?.currency === option.code ? "selected" : "" %>>
                                    <%= option.label %>
                                  </option>
                                <% } %>
                              </select>
                            </div>
                          </td>
                        <% } %>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              </div>

              <div class="table-card nested-card">
                <div class="section-title compact">
                  <div>
                    <p class="eyebrow"><%= t("customs.categories.terminalStorage") %></p>
                    <h4><%= t("customs.variableFeeTable") %></h4>
                  </div>
                </div>

                <% for (const type of businessModuleRules.containerTypes || []) { %>
                  <% const rules = terminal.storageRulesByContainer?.[type.key] || []; %>
                  <div class="table-card nested-card">
                    <div class="section-title compact">
                      <div>
                        <p class="eyebrow"><%= t("admin.groupLabel") %></p>
                        <h4><%= type.label %></h4>
                      </div>
                      <button
                        type="submit"
                        class="ghost-button compact-button"
                        formaction="/admin/customs/terminals/<%= terminal.id %>/storage/<%= type.key %>/add"
                        formmethod="post"
                      ><%= t("admin.addRule") %></button>
                    </div>
                    <table>
                      <thead>
                        <tr>
                          <th><%= t("admin.startDay") %></th>
                          <th><%= t("admin.endDay") %></th>
                          <th><%= t("admin.taxRate") %></th>
                          <th><%= t("admin.amount") %></th>
                          <th><%= t("admin.currency") %></th>
                          <th><%= t("admin.actions") %></th>
                        </tr>
                      </thead>
                      <tbody>
                        <% for (const rule of rules) { %>
                          <tr>
                            <td><input type="number" value="<%= rule.startDay ?? '' %>" readonly /></td>
                            <td>
                              <input
                                type="number"
                                min="0"
                                step="1"
                                name="terminal_rule_<%= terminal.id %>_<%= type.key %>_<%= rule.id %>_end"
                                value="<%= rule.endDay ?? '' %>"
                                placeholder="<%= t("customs.autoRangeHint") %>"
                              />
                            </td>
                            <td>
                              <select name="terminal_rule_<%= terminal.id %>_<%= type.key %>_<%= rule.id %>_tax">
                                <% for (const preset of businessModuleRules.taxRatePresets || []) { %>
                                  <option value="<%= preset.rate %>" <%= String(rule.taxRate) === String(preset.rate) ? "selected" : "" %>>
                                    <%= preset.label %>
                                  </option>
                                <% } %>
                              </select>
                            </td>
                            <td><input type="number" min="0" step="0.01" name="terminal_rule_<%= terminal.id %>_<%= type.key %>_<%= rule.id %>_rate" value="<%= rule.rateConfig?.rate ?? 0 %>" /></td>
                            <td>
                              <select name="terminal_rule_<%= terminal.id %>_<%= type.key %>_<%= rule.id %>_currency">
                                <% for (const option of currencyOptions) { %>
                                  <option value="<%= option.code %>" <%= rule.rateConfig?.currency === option.code ? "selected" : "" %>>
                                    <%= option.label %>
                                  </option>
                                <% } %>
                              </select>
                            </td>
                            <td>
                              <button
                                type="submit"
                                class="ghost-button compact-button"
                                formaction="/admin/customs/terminals/<%= terminal.id %>/storage/<%= type.key %>/<%= rule.id %>/delete"
                                formmethod="post"
                                <%= rules.length <= 1 ? "disabled" : "" %>
                              ><%= t("admin.deleteRule") %></button>
                            </td>
                          </tr>
                        <% } %>
                      </tbody>
                    </table>
                    <p class="helper-text"><%= t("admin.autoSequentialHint") %></p>
                  </div>
                <% } %>
              </div>
            </div>
          <% } %>
        </article>
      <% } %>
    </div>
  </section>

  <section class="panel">
    <div class="section-title">
      <div>
        <p class="eyebrow"><%= t("customs.yardRulesTitle") %></p>
        <h3><%= t("customs.yardRulesDescription") %></h3>
      </div>
    </div>

    <div class="stack-form">
      <% for (const yard of businessModuleRules.yards || []) { %>
        <article class="table-card nested-card">
          <div class="section-title compact">
            <div>
              <p class="eyebrow"><%= t("customs.yardLabel") %></p>
              <h4><%= yard.name %></h4>
            </div>
          </div>

          <div class="grid-form">
            <label>
              <span><%= t("customs.yardLabel") %></span>
              <input type="text" name="yard_name_<%= yard.id %>" value="<%= yard.name %>" />
            </label>
            <label class="full-width">
              <span><%= t("common.note") %></span>
              <input type="text" name="yard_note_<%= yard.id %>" value="<%= yard.note || '' %>" />
            </label>
            <label>
              <span><%= t("customs.portLabel") %></span>
              <select name="yard_portIds_<%= yard.id %>" multiple size="<%= Math.min(5, Math.max(2, businessModuleRules.ports.length)) %>">
                <% for (const port of businessModuleRules.ports || []) { %>
                  <option value="<%= port.id %>" <%= yard.portIds?.includes(port.id) ? "selected" : "" %>>
                    <%= port.name %>
                  </option>
                <% } %>
              </select>
            </label>
            <label>
              <span><%= t("customs.shippingLineLabel") %></span>
              <select name="yard_shippingLineIds_<%= yard.id %>" multiple size="<%= Math.min(6, Math.max(3, businessModuleRules.shippingLines.length)) %>">
                <% for (const line of businessModuleRules.shippingLines || []) { %>
                  <option value="<%= line.id %>" <%= yard.shippingLineIds?.includes(line.id) ? "selected" : "" %>>
                    <%= line.name %>
                  </option>
                <% } %>
              </select>
            </label>
          </div>

          <% for (const chargeGroup of [
            { list: yard.dropoffCharges, prefix: "yard_dropoff", key: "customs.categories.yardDropoff", title: t("customs.dropoffFeeTable") },
            { list: yard.customsCharges, prefix: "yard_customs", key: "customs.categories.yardCustoms", title: t("customs.customsFeeTable") },
          ]) { %>
            <div class="table-card nested-card">
              <div class="section-title compact">
                <div>
                  <p class="eyebrow"><%= t(chargeGroup.key) %></p>
                  <h4><%= chargeGroup.title %></h4>
                </div>
              </div>
              <table>
                <thead>
                  <tr>
                    <th><%= t("admin.item") %></th>
                    <th><%= t("common.note") %></th>
                    <th><%= t("admin.taxRate") %></th>
                    <% for (const type of businessModuleRules.containerTypes || []) { %>
                      <th><%= type.label %></th>
                    <% } %>
                  </tr>
                </thead>
                <tbody>
                  <% for (const charge of chargeGroup.list || []) { %>
                    <tr>
                      <td><input type="text" name="<%= chargeGroup.prefix %>_concept_<%= yard.id %>_<%= charge.id %>" value="<%= charge.concept %>" /></td>
                      <td><input type="text" name="<%= chargeGroup.prefix %>_note_<%= yard.id %>_<%= charge.id %>" value="<%= charge.note || '' %>" /></td>
                      <td>
                        <select name="<%= chargeGroup.prefix %>_tax_<%= yard.id %>_<%= charge.id %>">
                          <% for (const preset of businessModuleRules.taxRatePresets || []) { %>
                            <option value="<%= preset.rate %>" <%= String(charge.taxRate) === String(preset.rate) ? "selected" : "" %>>
                              <%= preset.label %>
                            </option>
                          <% } %>
                        </select>
                      </td>
                      <% for (const type of businessModuleRules.containerTypes || []) { %>
                        <% const rate = charge.groupRates?.[type.key]; %>
                        <td>
                          <div class="rate-cell">
                            <input type="number" min="0" step="0.01" name="<%= chargeGroup.prefix %>_<%= yard.id %>_<%= charge.id %>_<%= type.key %>_rate" value="<%= rate?.rate ?? 0 %>" />
                            <select name="<%= chargeGroup.prefix %>_<%= yard.id %>_<%= charge.id %>_<%= type.key %>_currency">
                              <% for (const option of currencyOptions) { %>
                                <option value="<%= option.code %>" <%= rate?.currency === option.code ? "selected" : "" %>>
                                  <%= option.label %>
                                </option>
                              <% } %>
                            </select>
                          </div>
                        </td>
                      <% } %>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          <% } %>
        </article>
      <% } %>
    </div>
  </section>

  <div class="actions">
    <button type="submit"><%= t("admin.saveShippingLine") %></button>
  </div>
</form>

<%- include("partials/footer") %>
