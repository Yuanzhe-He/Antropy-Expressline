<%- include("partials/header", { pageTitle, currentPath, currentArea, currentModuleKey, currentModule, user, userRoleLabel, flash, lang, t, languageOptions, languageReturnTo, modules }) %>

<section class="page-heading page-heading-card">
  <div class="page-heading-title"><h2><%= t("quote.adminTitle") %></h2></div>
  <div class="module-intro-card"><p><%= t("quote.adminDescription") %></p></div>
</section>

<%- include("partials/admin-tabs", { modules, currentModuleKey, currentAdminSection, t }) %>

<style>
  .cargo-type-row { display: grid; grid-template-columns: minmax(90px, 0.7fr) minmax(160px, 2fr) minmax(100px, 0.8fr) auto; gap: 0.75rem; align-items: end; }
  .cargo-type-row label { min-width: 0; }
  .cargo-type-row input[readonly] { opacity: 0.7; }
  .cargo-type-row .actions { margin: 0; }
  .cargo-type-error { color: var(--danger, #d94c4c); }
  .cargo-pricing-rules { display: grid; gap: .6rem; }
  .cargo-pricing-rule { display: grid; grid-template-columns: 70px minmax(210px, 2fr) minmax(160px, 1fr); align-items: end; gap: .75rem; }
  .cargo-pricing-rule strong { padding-bottom: .75rem; }
  .cargo-pricing-rule label { min-width: 0; }
  @media (max-width: 650px) { .cargo-pricing-rule { grid-template-columns: 1fr; } .cargo-pricing-rule strong { padding: 0; } }
  @media (max-width: 650px) { .cargo-type-row { grid-template-columns: 1fr 1fr; } .cargo-type-name { grid-column: 1 / -1; grid-row: 2; } }
</style>

<form method="post" action="/admin/quote/settings" class="stack-form">
  <%- include("partials/quote-fee-settings", { quoteSettings, feeCategories, feeUomOptions, feeError, feeErrorCode, currencyError, postedCurrencyRows: typeof postedCurrencyRows !== 'undefined' ? postedCurrencyRows : undefined, lang }) %>
  <section class="panel" id="quote-cargo-types" data-cargo-editor>
    <input type="hidden" name="cargoTypesPresent" value="1" />
    <div class="section-title">
      <div><p class="eyebrow"><%= t("quote.cargoTypesTitle") %></p><small><%= t("quote.cargoTypesHint") %></small></div>
      <button type="button" class="ghost-button compact-button" data-cargo-add><%= t("quote.addCargoType") %></button>
    </div>
    <% if (typeof cargoError !== "undefined" && cargoError) { %>
      <p class="cargo-type-error" role="alert" tabindex="-1" data-cargo-error><%= cargoError %></p>
    <% } %>
    <div data-cargo-rows class="stack-form">
      <% const existingCargoRows = new Set();
      (quoteSettings.cargoTypes || []).forEach((entry) => {
        const existing = typeof storedCargoCodes === "undefined" || (storedCargoCodes.includes(entry.code) && !existingCargoRows.has(entry.code));
        if (existing) existingCargoRows.add(entry.code);
      %>
        <div class="table-card nested-card cargo-type-row" data-cargo-row>
          <label><span><%= t("quote.cargoTypeCode") %></span><input type="text" name="cargo_code[]" value="<%= entry.code %>" required maxlength="32" pattern="[A-Za-z0-9][A-Za-z0-9_-]{0,31}" <%= existing ? 'readonly' : '' %> /></label>
          <label class="cargo-type-name"><span><%= t("quote.cargoTypeName") %></span><input type="text" name="cargo_label[]" value="<%= entry.label %>" required maxlength="120" /></label>
          <label><span><%= t("quote.cargoTypeStatus") %></span><select name="cargo_enabled[]"><option value="1" <%= entry.enabled ? 'selected' : '' %>><%= t("quote.cargoTypeEnabled") %></option><option value="0" <%= !entry.enabled ? 'selected' : '' %>><%= t("quote.cargoTypeDisabled") %></option></select></label>
          <% if (!existing) { %><div class="actions"><button type="button" class="ghost-button compact-button" data-cargo-remove><%= t("quote.removeNewCargoType") %></button></div><% } %>
        </div>
      <% }) %>
    </div>
    <p class="quote-hint" data-cargo-empty <%= (quoteSettings.cargoTypes || []).some((entry) => entry.enabled) ? 'hidden' : '' %>><%= t("quote.cargoTypesEmpty") %></p>
  </section>

  <section class="panel" id="quote-cargo-pricing" data-cargo-pricing-editor>
    <input type="hidden" name="cargoPricingRulesPresent" value="1" />
    <div class="section-title"><div><p class="eyebrow"><%= lang === 'es' ? 'Reglas de cálculo por tipo de carga' : '各装载方式的计费规则' %></p></div></div>
    <p class="quote-hint"><%= lang === 'es' ? 'Estos valores se aplican a cálculos nuevos. FCL se cotiza por tipo y cantidad de contenedor. AIR requiere cantidad manual hasta que se confirme otra regla. Las cotizaciones guardadas conservan sus datos.' : '用于新建计费。FCL 按柜型、数量和单价计费；AIR 默认手动填写计费量，确认规则后可在此调整。已保存报价保留原有数据。' %></p>
    <% if (cargoPricingError) { %><p class="cargo-type-error" role="alert" tabindex="-1" data-cargo-pricing-error><%= cargoPricingError %></p><% } %>
    <div class="cargo-pricing-rules">
      <% ['LCL', 'BBK', 'AIR'].forEach((type) => {
        const rule = cargoPricingRules[type];
        const methods = ['raw_max', 'volumetric', 'manual'];
        if (rule.method && !methods.includes(rule.method)) methods.unshift(rule.method);
        const labels = lang === 'es'
          ? {raw_max: 'Máximo numérico de kg y cm³', volumetric: 'Mayor entre kg y cm³ ÷ divisor', manual: 'Cantidad facturable manual'}
          : {raw_max: 'kg 与 cm³ 原始数值取较大者', volumetric: 'kg 与体积重（cm³ ÷ 系数）取较大者', manual: '手动填写计费量'};
      %>
        <div class="cargo-pricing-rule" data-cargo-pricing-rule>
          <strong><%= type %></strong><input type="hidden" name="pricing_type[]" value="<%= type %>" />
          <label><span><%= lang === 'es' ? 'Método' : '默认计费方式' %></span><select name="pricing_method[]" data-pricing-method>
            <% methods.forEach((method) => { %><option value="<%= method %>" <%= rule.method === method ? 'selected' : '' %>><%= labels[method] || method %></option><% }) %>
          </select></label>
          <label><span><%= lang === 'es' ? 'Divisor volumétrico (cm³/kg)' : '体积系数（cm³/kg）' %></span><input name="pricing_divisor[]" data-pricing-divisor inputmode="decimal" value="<%= rule.volumeDivisor ?? '' %>" <%= rule.method === 'volumetric' ? 'required' : '' %> placeholder="<%= lang === 'es' ? 'Sin valor predeterminado' : '无预设值' %>" /></label>
        </div>
      <% }) %>
    </div>
  </section>

  <section class="panel" id="quote-number">
    <div class="section-title"><div><p class="eyebrow"><%= t("quote.numberFormat") %></p></div></div>
    <div class="grid-form">
      <label><span><%= t("quote.numberPrefix") %></span><input type="text" name="quoteNumberPrefix" value="<%= quoteSettings.quoteNumberPrefix %>" /></label>
      <label><span><%= t("quote.numberSuffix") %></span><input type="text" name="quoteNumberSuffix" value="<%= quoteSettings.quoteNumberSuffix %>" /></label>
      <label><span><%= t("quote.numberPad") %></span><input type="number" min="1" max="8" name="quoteNumberPad" value="<%= quoteSettings.quoteNumberPad %>" /></label>
      <label><span><%= t("quote.lastSeq") %></span><input type="number" min="0" name="lastQuoteSeq" value="<%= quoteSettings.lastQuoteSeq %>" /></label>
    </div>
  </section>

  <section class="panel" id="quote-header-defaults">
    <div class="section-title"><div><p class="eyebrow"><%= t("quote.headerDefaultsTitle") %></p><small><%= t("quote.headerDefaultsHint") %></small></div></div>
    <% const hd = quoteSettings.headerDefaults || {}; %>
    <div class="grid-form">
      <label><span><%= t("quote.department") %></span>
        <select name="hd_department"><option value="">—</option>
          <% headerOptions.department.forEach((c) => { %><option value="<%= c %>" <%= hd.department === c ? "selected" : "" %>><%= c %></option><% }) %>
        </select></label>
      <label><span><%= t("quote.transportMode") %></span>
        <select name="hd_transportMode"><option value="">—</option>
          <% headerOptions.transportMode.forEach((c) => { %><option value="<%= c %>" <%= hd.transportMode === c ? "selected" : "" %>><%= c %></option><% }) %>
        </select></label>
      <label><span><%= t("quote.incoterm") %></span>
        <select name="hd_incoterm"><option value="">—</option>
          <% headerOptions.incoterm.forEach((c) => { %><option value="<%= c %>" <%= hd.incoterm === c ? "selected" : "" %>><%= c %></option><% }) %>
        </select></label>
      <label><span><%= t("quote.cargoType") %></span>
        <select name="hd_cargoType"><option value="">—</option>
          <% headerOptions.cargoType.forEach((entry) => { %><option value="<%= entry.code %>" <%= hd.cargoType === entry.code ? "selected" : "" %>><%= entry.label %></option><% }) %>
        </select></label>
      <label><span><%= t("quote.quoteMode") %></span>
        <select name="hd_quoteMode">
          <option value="mexico_only" <%= hd.quoteMode !== "ocean_mexico" ? "selected" : "" %>><%= t("quote.quoteModeMexicoOnly") %></option>
          <option value="ocean_mexico" <%= hd.quoteMode === "ocean_mexico" ? "selected" : "" %>><%= t("quote.quoteModeOceanMexico") %></option>
        </select></label>
    </div>
  </section>

  <section class="panel" id="quote-remarks">
    <input type="hidden" name="notesPresent" value="1" />
    <div class="section-title">
      <div><p class="eyebrow"><%= t("quote.remarksLibrary") %></p><small><%= t("quote.remarksLibraryHint") %></small></div>
      <button type="button" class="ghost-button compact-button" data-remark-add><%= t("quote.addRemark") %></button>
    </div>
    <div data-remark-rows class="stack-form">
      <% (quoteNotes || []).forEach((note) => { %>
        <div class="table-card nested-card" data-remark-row>
          <input type="hidden" name="note_id[]" value="<%= note.id %>" />
          <label><span>EN</span><input type="text" name="note_en[]" value="<%= note.en %>" /></label>
          <label><span>中文</span><input type="text" name="note_zh[]" value="<%= note.zh %>" lang="zh" /></label>
          <label><span>ES</span><input type="text" name="note_es[]" value="<%= note.es || '' %>" /></label>
          <div class="actions"><button type="button" class="ghost-button compact-button danger-button" data-remark-remove><%= t("quote.removeRemark") %></button></div>
        </div>
      <% }) %>
    </div>
  </section>

  <div class="actions sticky-save-bar">
    <button type="submit"><%= t("quote.adminSave") %></button>
  </div>
</form>

<template id="cargo-row-template">
  <div class="table-card nested-card cargo-type-row" data-cargo-row>
    <label><span><%= t("quote.cargoTypeCode") %></span><input type="text" name="cargo_code[]" value="" required maxlength="32" pattern="[A-Za-z0-9][A-Za-z0-9_-]{0,31}" /></label>
    <label class="cargo-type-name"><span><%= t("quote.cargoTypeName") %></span><input type="text" name="cargo_label[]" value="" required maxlength="120" /></label>
    <label><span><%= t("quote.cargoTypeStatus") %></span><select name="cargo_enabled[]"><option value="1"><%= t("quote.cargoTypeEnabled") %></option><option value="0" selected><%= t("quote.cargoTypeDisabled") %></option></select></label>
    <div class="actions"><button type="button" class="ghost-button compact-button" data-cargo-remove><%= t("quote.removeNewCargoType") %></button></div>
  </div>
</template>

<template id="remark-row-template">
  <div class="table-card nested-card" data-remark-row>
    <input type="hidden" name="note_id[]" value="" />
    <label><span>EN</span><input type="text" name="note_en[]" value="" /></label>
    <label><span>中文</span><input type="text" name="note_zh[]" value="" lang="zh" /></label>
    <label><span>ES</span><input type="text" name="note_es[]" value="" /></label>
    <div class="actions"><button type="button" class="ghost-button compact-button danger-button" data-remark-remove>✕</button></div>
  </div>
</template>

<script src="/admin-quote.js" defer></script>
<script src="/admin-quote-fees.js" defer></script>

<%- include("partials/footer") %>
