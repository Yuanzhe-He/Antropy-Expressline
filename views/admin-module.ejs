<%- include("partials/header", { pageTitle, currentPath, currentArea, currentModuleKey, currentModule, user, userRoleLabel, flash, lang, t, languageOptions, languageReturnTo, modules }) %>

<section class="hero-card hero-split">
  <div class="hero-copy">
    <p class="eyebrow"><%= t("admin.eyebrow") %></p>
    <h2><%= t("admin.shippingLineTitle") %></h2>
    <p class="hero-text"><%= selectedModule.description %></p>
  </div>
  <div class="hero-side">
    <div class="status-tile">
      <span><%= t("common.status") %></span>
      <strong><%= selectedModule.stateLabel %></strong>
    </div>
    <div class="status-tile">
      <span><%= t("admin.shippingLineTable") %></span>
      <strong><%= shippingLines.length %></strong>
    </div>
  </div>
</section>

<%- include("partials/admin-tabs", { modules, currentModuleKey, currentAdminSection, t }) %>

<section class="admin-layout">
  <aside class="panel admin-list" data-scroll-panel="admin-list">
    <div class="section-title">
      <div>
        <p class="eyebrow"><%= t("admin.lineList") %></p>
        <h3><%= selectedModule.title %></h3>
      </div>
    </div>
    <%# D (round-r3): self-serve "create carrier". Handover only (the add route
        404s elsewhere). Collapsed by default to keep the list tidy. %>
    <% if (currentModuleKey === "handover") { %>
      <details class="admin-create-line" style="margin-bottom: 0.75rem;">
        <summary class="ghost-button compact-button" style="cursor:pointer; display:inline-block;"><%= t("admin.addShippingLine") %></summary>
        <form method="post" action="/admin/<%= currentModuleKey %>/shipping-lines/add" class="stack-form" style="margin-top: 0.6rem; display:grid; gap:0.5rem;">
          <label>
            <span><%= t("admin.lineName") %> *</span>
            <input type="text" name="line_name" required placeholder="<%= t('admin.newShippingLineName') %>" />
          </label>
          <label>
            <span><%= t("admin.lineCode") %></span>
            <input type="text" name="line_code" placeholder="CODIGO DE NAVIERA" />
          </label>
          <label>
            <span><%= t("admin.lineRfc") %></span>
            <input type="text" name="line_rfc" placeholder="RFC / Tax ID" />
          </label>
          <p class="hint" style="font-size:0.78rem; opacity:0.75; margin:0;"><%= t("admin.createShippingLineHint") %></p>
          <button type="submit" class="primary-button compact-button"><%= t("admin.createShippingLine") %></button>
        </form>
      </details>
    <% } %>
    <label class="admin-search">
      <span><%= t("common.search") %></span>
      <input type="search" data-admin-filter placeholder="<%= t("admin.searchPlaceholder") %>" />
    </label>
    <div class="admin-links" data-admin-filter-list>
      <% for (const line of shippingLines) { %>
        <a
          class="<%= selectedLine?.id === line.id ? 'active' : '' %>"
          href="/admin/<%= currentModuleKey %>/shipping-lines/<%= line.id %>"
          data-admin-filter-item
        >
          <strong><%= line.name %></strong>
          <span><%= t("admin.shippingLineCount", {
            count: moduleData.containerTypes?.length || 0,
            rules: line.demurrage.ruleSets?.length || 0,
          }) %></span>
        </a>
      <% } %>
      <div class="note-box" data-admin-filter-empty hidden>
        <p><%= t("admin.noSearchResults") %></p>
      </div>
      <% if (!shippingLines.length) { %>
        <div class="note-box">
          <strong><%= t("admin.modulePlaceholderTitle") %></strong>
          <p><%= t("admin.modulePlaceholderDescription") %></p>
        </div>
      <% } %>
    </div>
  </aside>

  <section class="panel admin-detail" data-scroll-panel="admin-detail">
    <% if (!selectedLine) { %>
      <div class="empty-state">
        <h3><%= t("admin.selectShippingLine") %></h3>
        <p><%= shippingLines.length ? t("admin.selectShippingLineHint") : t("admin.noShippingLines") %></p>
      </div>
    <% } else { %>
      <div class="section-title">
        <div>
          <p class="eyebrow"><%= selectedLine.notes?.code || selectedModule.title %></p>
          <h3><%= selectedLine.name %></h3>
        </div>
        <div class="note-box">
          <p><%= t("admin.containerTable") %>: <%= moduleData.containerTypes?.length || 0 %></p>
        </div>
      </div>

      <form
        method="post"
        action="/admin/<%= currentModuleKey %>/shipping-lines/<%= selectedLine.id %>"
        class="stack-form"
        data-admin-form
        data-unsaved-label="<%= t("admin.unsavedChanges") %>"
        data-saved-label="<%= t("admin.savedState") %>"
        data-confirm-leave="<%= t("admin.confirmLeave") %>"
      >
        <div class="grid-form">
          <%# D (round-r3): carrier identity is now editable (was display-only). %>
          <label>
            <span><%= t("admin.lineName") %></span>
            <input type="text" name="line_name" value="<%= selectedLine.name %>" />
          </label>
          <label>
            <span><%= t("admin.lineCode") %></span>
            <input type="text" name="line_code" value="<%= selectedLine.notes?.code || '' %>" />
          </label>
          <label>
            <span><%= t("admin.lineRfc") %></span>
            <input type="text" name="line_rfc" value="<%= selectedLine.notes?.rfc || '' %>" />
          </label>
          <label class="checkbox-field">
            <span><%= t("admin.invoiceOnly") %></span>
            <input type="checkbox" name="invoiceToConsigneeOnly" <%= selectedLine.invoiceToConsigneeOnly ? "checked" : "" %> />
          </label>

          <label>
            <span><%= t("admin.invoiceNote") %></span>
            <input type="text" name="invoiceNote" value="<%= selectedLine.invoiceNote || '' %>" />
          </label>

          <label>
            <span><%= t("admin.cutoffHandler") %></span>
            <select name="demurrageCutoffHandledBy">
              <% for (const option of demurrageCutoffOptions) { %>
                <option value="<%= option.value %>" <%= selectedLine.demurrageCutoffHandledBy === option.value ? "selected" : "" %>>
                  <%= option.label %>
                </option>
              <% } %>
            </select>
          </label>

          <label class="checkbox-field">
            <span><%= t("admin.benefitEnabled") %></span>
            <input type="checkbox" name="benefitEnabled" <%= selectedLine.guarantee.benefitEnabled ? "checked" : "" %> />
          </label>

          <label>
            <span><%= t("admin.benefitExpiresAt") %></span>
            <input type="date" name="benefitExpiresAt" value="<%= selectedLine.guarantee.benefitExpiresAt || '' %>" />
          </label>

          <label class="full-width">
            <span><%= t("admin.benefitNote") %></span>
            <input type="text" name="benefitNote" value="<%= selectedLine.guarantee.benefitNote || '' %>" />
          </label>
        </div>

        <div class="table-card">
          <div class="section-title compact">
            <div>
              <p class="eyebrow"><%= t("admin.terminalMixEyebrow") %></p>
              <h4><%= t("admin.terminalMixTitle") %></h4>
              <small><%= t("admin.terminalMixDescription") %></small>
            </div>
            <button
              type="submit"
              class="ghost-button compact-button"
              formaction="/admin/<%= currentModuleKey %>/shipping-lines/<%= selectedLine.id %>/terminal-mix/add"
              formmethod="post"
            ><%= t("admin.addTerminalMix") %></button>
          </div>
          <table>
            <thead>
              <tr>
                <th><%= t("customs.portLabel") %></th>
                <th><%= t("customs.terminalLabel") %></th>
                <th><%= t("admin.probabilityPercent") %></th>
                <th><%= t("admin.actions") %></th>
              </tr>
            </thead>
            <tbody>
              <% for (const mix of selectedLine.terminalMix || []) { %>
                <% const terminalMixPercent = Math.round(Number(mix.ratio || 0) * 10000) / 100; %>
                <tr>
                  <td><input type="text" name="terminal_mix_<%= mix.id %>_port" value="<%= mix.port || '' %>" /></td>
                  <td><input type="text" name="terminal_mix_<%= mix.id %>_terminal" value="<%= mix.terminal || '' %>" /></td>
                  <td>
                    <input
                      type="number"
                      min="0"
                      max="100"
                      step="0.01"
                      name="terminal_mix_<%= mix.id %>_ratio"
                      value="<%= terminalMixPercent %>"
                    />
                  </td>
                  <td>
                    <button
                      type="submit"
                      class="ghost-button compact-button"
                      formaction="/admin/<%= currentModuleKey %>/shipping-lines/<%= selectedLine.id %>/terminal-mix/<%= mix.id %>/delete"
                      formmethod="post"
                      data-confirm-submit="<%= t("admin.confirmDeleteRule") %>"
                    ><%= t("admin.deleteTerminalMix") %></button>
                  </td>
                </tr>
              <% } %>
              <% if (!selectedLine.terminalMix?.length) { %>
                <tr>
                  <td colspan="4"><%= t("calculator.noTerminalMix") %></td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <div class="table-card">
          <div class="section-title compact">
            <div>
              <p class="eyebrow">Garantia</p>
              <h4><%= t("admin.guaranteeTitle") %></h4>
            </div>
          </div>
          <table>
            <thead>
              <tr>
                <th><%= t("admin.taxRate") %></th>
                <% for (const group of selectedLine.containerGroups || []) { %>
                  <th><%= group.label %></th>
                <% } %>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  <select name="guaranteeTaxRate">
                    <% for (const preset of moduleData.taxRatePresets) { %>
                      <option value="<%= preset.rate %>" <%= String(selectedLine.guarantee.taxRate) === String(preset.rate) ? "selected" : "" %>>
                        <%= preset.label %>
                      </option>
                    <% } %>
                  </select>
                </td>
                <% for (const group of selectedLine.containerGroups || []) { %>
                  <% const rate = selectedLine.guarantee.ratesByGroup?.[group.key]; %>
                  <td>
                    <div class="rate-cell">
                      <input type="number" min="0" step="0.01" name="guarantee_<%= group.key %>_rate" value="<%= rate ? rate.rate : '' %>" placeholder="—" />
                      <select name="guarantee_<%= group.key %>_currency">
                        <% for (const option of currencyOptions) { %>
                          <option value="<%= option.code %>" <%= (rate ? rate.currency : 'MXN') === option.code ? "selected" : "" %>>
                            <%= option.label %>
                          </option>
                        <% } %>
                      </select>
                    </div>
                  </td>
                <% } %>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="table-card">
          <div class="section-title compact">
            <div>
              <p class="eyebrow">Local Charges</p>
              <h4><%= t("admin.localChargesTitle") %></h4>
            </div>
            <button
              type="submit"
              class="ghost-button compact-button"
              formaction="/admin/<%= currentModuleKey %>/shipping-lines/<%= selectedLine.id %>/local-charges/add"
              formmethod="post"
            ><%= t("admin.addLocalCharge") %></button>
          </div>
          <table>
            <thead>
              <tr>
                <th><%= t("admin.item") %></th>
                <th><%= t("admin.taxRate") %></th>
                <th>BL</th>
                <% for (const group of selectedLine.containerGroups || []) { %>
                  <th><%= group.label %></th>
                <% } %>
                <th><%= t("admin.actions") %></th>
              </tr>
            </thead>
            <tbody>
              <% for (const charge of selectedLine.localCharges || []) { %>
                <tr>
                  <td>
                    <input type="text" name="charge_concept_<%= charge.id %>" value="<%= charge.concept %>" />
                  </td>
                  <td>
                    <select name="charge_tax_<%= charge.id %>">
                      <% for (const preset of moduleData.taxRatePresets) { %>
                        <option value="<%= preset.rate %>" <%= String(charge.taxRate) === String(preset.rate) ? "selected" : "" %>>
                          <%= preset.label %>
                        </option>
                      <% } %>
                    </select>
                  </td>
                  <td>
                    <div class="rate-cell">
                      <input type="number" min="0" step="0.01" name="charge_bl_<%= charge.id %>_rate" value="<%= charge.blRate ? charge.blRate.rate : '' %>" placeholder="—" />
                      <select name="charge_bl_<%= charge.id %>_currency">
                        <% for (const option of currencyOptions) { %>
                          <option value="<%= option.code %>" <%= (charge.blRate ? charge.blRate.currency : 'MXN') === option.code ? "selected" : "" %>>
                            <%= option.label %>
                          </option>
                        <% } %>
                      </select>
                    </div>
                  </td>
                  <% for (const group of selectedLine.containerGroups || []) { %>
                    <% const rate = charge.groupRates?.[group.key]; %>
                    <td>
                      <div class="rate-cell">
                        <input type="number" min="0" step="0.01" name="charge_<%= charge.id %>_<%= group.key %>_rate" value="<%= rate ? rate.rate : '' %>" placeholder="—" />
                        <select name="charge_<%= charge.id %>_<%= group.key %>_currency">
                          <% for (const option of currencyOptions) { %>
                            <option value="<%= option.code %>" <%= (rate ? rate.currency : 'MXN') === option.code ? "selected" : "" %>>
                              <%= option.label %>
                            </option>
                          <% } %>
                        </select>
                      </div>
                    </td>
                  <% } %>
                  <td>
                    <button
                      type="submit"
                      class="ghost-button compact-button danger-button"
                      formaction="/admin/<%= currentModuleKey %>/shipping-lines/<%= selectedLine.id %>/local-charges/<%= charge.id %>/delete"
                      formmethod="post"
                      data-confirm-submit="<%= t("admin.confirmDeleteRule") %>"
                    ><%= t("admin.deleteLocalCharge") %></button>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <div class="table-card">
          <div class="section-title compact">
            <div>
              <p class="eyebrow">Demoras</p>
              <h4><%= t("admin.demurrageTitle") %></h4>
            </div>
            <button
              type="submit"
              class="ghost-button compact-button"
              formaction="/admin/<%= currentModuleKey %>/shipping-lines/<%= selectedLine.id %>/demurrage-rule-sets/add"
              formmethod="post"
            ><%= t("admin.addRuleSet") %></button>
          </div>
          <div class="stack-form">
            <div class="table-card nested-card">
              <div class="section-title compact">
                <div>
                  <p class="eyebrow"><%= t("admin.demurrageAssignmentsTitle") %></p>
                  <h4><%= t("admin.containerTable") %></h4>
                </div>
              </div>
              <table>
                <thead>
                  <tr>
                    <th><%= t("admin.typeKey") %></th>
                    <th><%= t("admin.typeName") %></th>
                    <th><%= t("admin.assignedRuleSet") %></th>
                  </tr>
                </thead>
                <tbody>
                  <% for (const type of moduleData.containerTypes || []) { %>
                    <% const assignedRuleSetId = selectedLine.demurrage.assignmentsByContainerType?.[type.key] || selectedLine.demurrage.ruleSets?.[0]?.id || ""; %>
                    <tr>
                      <td><%= type.key %></td>
                      <td><%= type.description || type.label %></td>
                      <td>
                        <select name="demurrage_assignment_<%= type.key %>">
                          <% for (const ruleSet of selectedLine.demurrage.ruleSets || []) { %>
                            <option value="<%= ruleSet.id %>" <%= assignedRuleSetId === ruleSet.id ? "selected" : "" %>>
                              <%= ruleSet.name %>
                            </option>
                          <% } %>
                        </select>
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>

            <% for (const ruleSet of selectedLine.demurrage.ruleSets || []) { %>
              <% const rules = ruleSet.rules || []; %>
              <div class="table-card nested-card">
                <div class="section-title compact">
                  <div>
                    <p class="eyebrow"><%= t("admin.demurrageRuleSetsTitle") %></p>
                    <label>
                      <span><%= t("admin.ruleSetName") %></span>
                      <input type="text" name="demurrage_set_<%= ruleSet.id %>_name" value="<%= ruleSet.name %>" />
                    </label>
                  </div>
                  <div class="inline-actions">
                    <button
                      type="submit"
                      class="ghost-button compact-button"
                      formaction="/admin/<%= currentModuleKey %>/shipping-lines/<%= selectedLine.id %>/demurrage-rule-sets/<%= ruleSet.id %>/add"
                      formmethod="post"
                    ><%= t("admin.addRule") %></button>
                    <button
                      type="submit"
                      class="ghost-button compact-button danger-button"
                      formaction="/admin/<%= currentModuleKey %>/shipping-lines/<%= selectedLine.id %>/demurrage-rule-sets/<%= ruleSet.id %>/delete"
                      formmethod="post"
                      data-confirm-submit="<%= t("admin.confirmDeleteRuleSet", { name: ruleSet.name }) %>"
                      <%= (selectedLine.demurrage.ruleSets || []).length <= 1 ? "disabled" : "" %>
                    ><%= t("admin.deleteRuleSet") %></button>
                  </div>
                </div>
                <table>
                  <thead>
                    <tr>
                      <th>Label</th>
                      <th><%= t("admin.startDay") %></th>
                      <th><%= t("admin.endDay") %></th>
                      <th><%= t("admin.taxRate") %></th>
                      <th><%= t("admin.amount") %></th>
                      <th><%= t("admin.currency") %></th>
                      <th><%= t("admin.actions") %></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% for (const rule of rules) { %>
                      <tr>
                        <td><%= rule.label %><%= rule.freeRule ? ` (${t("admin.freeRule")})` : "" %></td>
                        <td>
                          <input type="number" min="0" step="1" value="<%= rule.startDay ?? '' %>" readonly />
                        </td>
                        <td>
                          <input type="number" min="0" step="1" name="rule_set_<%= ruleSet.id %>_<%= rule.id %>_end" value="<%= rule.endDay ?? '' %>" placeholder="<%= t("admin.emptyEndDay") %>" />
                        </td>
                        <td>
                          <select name="rule_set_<%= ruleSet.id %>_<%= rule.id %>_tax">
                            <% for (const preset of moduleData.taxRatePresets) { %>
                              <option value="<%= preset.rate %>" <%= String(rule.taxRate) === String(preset.rate) ? "selected" : "" %>>
                                <%= preset.label %>
                              </option>
                            <% } %>
                          </select>
                        </td>
                        <td>
                          <input type="number" min="0" step="0.01" name="rule_set_<%= ruleSet.id %>_<%= rule.id %>_rate" value="<%= rule.rateConfig.rate %>" />
                        </td>
                        <td>
                          <select name="rule_set_<%= ruleSet.id %>_<%= rule.id %>_currency">
                            <% for (const option of currencyOptions) { %>
                              <option value="<%= option.code %>" <%= rule.rateConfig.currency === option.code ? "selected" : "" %>>
                                <%= option.label %>
                              </option>
                            <% } %>
                          </select>
                        </td>
                        <td>
                          <button
                            type="submit"
                            class="ghost-button compact-button"
                            formaction="/admin/<%= currentModuleKey %>/shipping-lines/<%= selectedLine.id %>/demurrage-rule-sets/<%= ruleSet.id %>/<%= rule.id %>/delete"
                            formmethod="post"
                            data-confirm-submit="<%= t("admin.confirmDeleteRule") %>"
                            <%= rules.length <= 1 ? "disabled" : "" %>
                          ><%= t("admin.deleteRule") %></button>
                        </td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
                <p class="helper-text"><%= t("admin.autoSequentialHint") %></p>
              </div>
            <% } %>
          </div>
        </div>

        <div class="actions sticky-save-bar">
          <span class="save-state" data-save-state><%= t("admin.savedState") %></span>
          <button type="button" class="ghost-button compact-button" data-discard-changes disabled><%= t("admin.discardChanges") %></button>
          <%# D (round-r3): delete this carrier (handover only) — cascades the
              customs mirror + yard↔line references server-side. %>
          <% if (currentModuleKey === "handover") { %>
            <button
              type="submit"
              class="ghost-button compact-button danger-button"
              formaction="/admin/<%= currentModuleKey %>/shipping-lines/<%= selectedLine.id %>/delete"
              formmethod="post"
              formnovalidate
              data-confirm-submit="<%= t("admin.confirmDeleteShippingLine", { name: selectedLine.name }) %>"
            ><%= t("admin.deleteShippingLine") %></button>
          <% } %>
          <button type="submit"><%= t("admin.saveShippingLine") %></button>
        </div>
      </form>
    <% } %>
  </section>
</section>

<%- include("partials/footer") %>
