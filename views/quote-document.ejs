<%
  var documentQuoteType = (typeof quoteType !== "undefined" ? quoteType : header.quoteType) === "long_term" ? "long_term" : "single";
  var longTerm = documentQuoteType === "long_term";
%>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="color-scheme" content="light only" />
<title><%= number %></title>
<style>
  :root { color-scheme: light; }
  <% if (assets.fontSans) { %>
  @font-face { font-family: "Noto Sans"; font-style: normal; font-weight: 400; src: url("<%= assets.fontSans %>") format("woff2"); }
  <% } %>
  <% if (assets.fontSansBold) { %>
  @font-face { font-family: "Noto Sans"; font-style: normal; font-weight: 700; src: url("<%= assets.fontSansBold %>") format("woff2"); }
  <% } %>
  <% if (assets.fontCjk) { %>
  @font-face { font-family: "Noto Sans SC"; font-style: normal; font-weight: 400; src: url("<%= assets.fontCjk %>") format("woff2"); }
  @font-face { font-family: "Noto Sans SC"; font-style: normal; font-weight: 700; src: url("<%= assets.fontCjk %>") format("woff2"); }
  <% } %>

  @page { size: A4<%= longTerm ? ' landscape' : '' %>; margin: 12mm 10mm 16mm; }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; background: #ffffff; }
  body {
    font-family: "Noto Sans", "Noto Sans SC", Arial, sans-serif;
    color: #15202b; font-size: 9.5px; line-height: 1.35;
    background: #ffffff;
  }
  .zh { font-family: "Noto Sans SC", "Noto Sans", sans-serif; }

  .doc-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .logo-box { height: 46px; display: flex; align-items: center; }
  .logo-box img { height: 44px; width: auto; max-width: 230px; object-fit: contain; }
  .logo-ph { border: 1px dashed #9aa7b4; color: #6b7785; font-size: 8px; padding: 6px 10px; border-radius: 4px; height: 46px; display: flex; align-items: center; justify-content: center; min-width: 150px; text-align: center; }

  .quote-meta { display: flex; gap: 0; margin: 10px 0 6px; border: 1px solid #2f3b8c; }
  .quote-meta div { flex: 1; padding: 4px 8px; }
  .quote-meta .lbl { font-weight: 700; color: #2f3b8c; font-size: 8px; letter-spacing: 0.04em; }
  .quote-meta div + div { border-left: 1px solid #2f3b8c; }

  .band { break-after: avoid; page-break-after: avoid; background: #2f3b8c; color: #fff; font-weight: 700; letter-spacing: 0.05em; padding: 4px 8px; font-size: 9px; margin-top: 10px; }

  table.general { width: 100%; border-collapse: collapse; }
  table.general td { border: 1px solid #b9c2cc; padding: 3px 7px; }
  table.general td.k { background: #eef1f8; font-weight: 700; width: 120px; white-space: nowrap; }

  table.charges { width: 100%; border-collapse: collapse; margin-top: 0; }
  table.charges th { background: #3b4ab0; color: #fff; padding: 4px 6px; font-size: 8px; letter-spacing: 0.03em; border: 1px solid #2f3b8c; text-align: left; }
  table.charges thead { display: table-header-group; break-inside: avoid; page-break-inside: avoid; break-after: avoid; page-break-after: avoid; }
  table.charges thead tr { break-after: avoid; page-break-after: avoid; }
  table.charges tbody tr:first-child { break-before: avoid; page-break-before: avoid; }
  table.charges td.charge-heading-cell { padding: 0; border: 0; }
  table.charges tr { break-inside: avoid; page-break-inside: avoid; }
  table.general td.qualification-key { white-space: normal; width: 50%; }
  .charge-section-label { padding: 4px 7px; background: #eef1f8; color: #2f3b8c; font-weight: 700; font-size: 8px; border: 1px solid #b9c2cc; border-bottom: 0; margin-top: 5px; break-after: avoid; page-break-after: avoid; }
  .charge-section-hint { margin: 4px 0 6px; color: #41505f; font-size: 8px; }
  .contingent-band { background: #53657f; }
  .subtotal-note { margin-top: 5px; color: #41505f; font-size: 8px; }
  table.charges td { border: 1px solid #b9c2cc; padding: 3px 6px; vertical-align: middle; }
  table.charges td.cat { font-weight: 700; background: #eef1f8; width: 92px; vertical-align: middle; }
  table.charges td.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  table.charges td.cur { text-align: center; }
  .concept-en { font-weight: 700; }
  .concept-zh { font-size: 8.5px; color: #41505f; }
  .atcost { color: #6b7785; }
  .rate-card-panel + .rate-card-panel { break-before: page; page-break-before: always; }
  table.rate-card { table-layout: fixed; }
  table.rate-card th, table.rate-card td { overflow-wrap: anywhere; }
  table.rate-card td.num { white-space: normal; }
  table.rate-card th.specification { text-align: right; }
  table.rate-card td.quantity { text-align: center; }

  .route-meta { margin-top: 6px; font-size: 8.5px; color: #41505f; border-left: 3px solid #3b4ab0; padding: 3px 8px; background: #f5f6fb; }
  .route-meta b { color: #2f3b8c; }
  .route-meta .ferry { color: #9a5b00; font-weight: 700; }

  .subtotals { display: flex; gap: 22px; margin-top: 8px; font-size: 10px; }
  .subtotals b { font-size: 12px; }
  .indicative { color: #6b7785; margin-top: 2px; font-size: 8px; }

  .dual-totals { display: flex; gap: 10px; align-items: stretch; margin-top: 10px; flex-wrap: wrap; }
  .dual-box { border: 1px solid #2f3b8c; border-radius: 4px; min-width: 170px; overflow: hidden; }
  .dual-box .dual-cur { background: #2f3b8c; color: #fff; font-weight: 700; font-size: 8px; letter-spacing: 0.05em; padding: 3px 8px; }
  .dual-box .dual-amt { font-size: 14px; font-weight: 700; color: #15202b; padding: 4px 8px 1px; }
  .dual-box .dual-iva { font-size: 7.5px; color: #41505f; padding: 0 8px 4px; }
  .dual-fx { align-self: center; color: #6b7785; font-size: 8px; }
  .dual-note { margin-top: 4px; font-size: 7.5px; color: #6b7785; line-height: 1.3; }
  .dual-note .zh { color: #6b7785; }

  .notes { margin-top: 12px; break-inside: avoid; page-break-inside: avoid; }
  .notes ol { margin: 4px 0 0; padding-left: 16px; orphans: 3; widows: 3; }
  .notes li { margin-bottom: 3px; break-inside: avoid; page-break-inside: avoid; }
  .notes .zh { color: #41505f; }

  .doc-footer {
    position: static; margin-top: 12px; height: 12mm; break-inside: avoid;
    display: flex; align-items: center; justify-content: space-between;
    border-top: 1px solid #2f3b8c; padding-top: 4px;
  }
  .doc-footer .brand { font-weight: 700; color: #2f3b8c; font-size: 10px; }
  .doc-footer .marks { display: flex; align-items: center; gap: 10px; }
  .doc-footer .marks img { height: 24px; width: auto; max-width: 90px; object-fit: contain; }
  .doc-footer .mark-ph { border: 1px dashed #9aa7b4; color: #6b7785; font-size: 7px; padding: 3px 6px; border-radius: 3px; }
  /* The PDF renderer places the repeating footer in its reserved page margin. */
  @media print { .doc-footer { display: none; } }
</style>
</head>
<body>
<%
  // Q7: single-language (EN/ZH/ES) or bilingual ("" = EN + 中, legacy default).
  var qlang = (typeof language !== "undefined" && language) ? language : "";
  var single = qlang === "EN" || qlang === "ZH" || qlang === "ES";
  var labelLang = single ? qlang : "EN";
  var internal = typeof outputAudience !== "undefined" && outputAudience === "internal";
  // A rate card contains alternatives, so aggregate amounts are never meaningful.
  var includeTotals = !longTerm && typeof showTotals !== "undefined" && showTotals === true;
  var tax = typeof taxTreatment !== "undefined" ? taxTreatment : "unspecified";
  var LBL = {
    date: { EN: "DATE", ZH: "日期", ES: "FECHA" },
    number: { EN: "QUOTATION NUMBER", ZH: "报价编号", ES: "NÚMERO" },
    quoteType: { EN: "QUOTATION TYPE", ZH: "报价类型", ES: "TIPO DE COTIZACIÓN" },
    singleQuote: { EN: "Single shipment", ZH: "单票报价", ES: "Embarque único" },
    longTermQuote: { EN: "Long-term rate card", ZH: "长期报价", ES: "Tarifario de largo plazo" },
    rateCardHint: { EN: "Unit rates for a quantity of 1. Specifications are alternatives and are not added together. — means no rate offered.", ZH: "数量固定为 1，展示各规格单价；不同规格不累加。— 表示未提供报价。", ES: "Tarifas unitarias para una cantidad de 1. Las especificaciones son alternativas y no se suman. — indica una tarifa no ofrecida." },
    rateCardContingentHint: { EN: "These unit rates apply only if the stated event occurs.", ZH: "以下单价仅在相应情况实际发生时适用。", ES: "Estas tarifas unitarias aplican únicamente si ocurre la situación indicada." },
    general: { EN: "GENERAL DATA", ZH: "基本信息", ES: "DATOS GENERALES" },
    operation: { EN: "OPERATION", ZH: "业务", ES: "OPERACIÓN" },
    incoterm: { EN: "INCOTERM", ZH: "贸易术语", ES: "INCOTERM" },
    department: { EN: "DEPARTMENT", ZH: "部门", ES: "DEPARTAMENTO" },
    transport: { EN: "TRANSPORT MODE", ZH: "运输方式", ES: "MODO DE TRANSPORTE" },
    cargo: { EN: "CARGO TYPE", ZH: "装载方式", ES: "TIPO DE CARGA" },
    pol: { EN: "POL", ZH: "起运港", ES: "POL" },
    pod: { EN: "POD", ZH: "目的港", ES: "POD" },
    commodity: { EN: "COMMODITY", ZH: "品名", ES: "MERCANCÍA" },
    delivery: { EN: "DELIVERY", ZH: "目的地", ES: "ENTREGA" },
    importerQualification: { EN: "IMPORT QUALIFICATION", ZH: "进口资质来源", ES: "IMPORTADOR" },
    specialImportQualification: { EN: "SPECIAL IMPORT QUALIFICATION REQUIRED", ZH: "是否需要特殊进口资质", ES: "¿REQUIERE PERMISO O PADRÓN ESPECIAL?" },
    nomCertification: { EN: "NOM CERTIFICATION REQUIRED", ZH: "是否需要 NOM 认证", ES: "¿REQUIERE CERTIFICACIÓN NOM?" },
    ministryRegistration: { EN: "ECONOMY MINISTRY REGISTRATION REQUIRED", ZH: "是否需要经济部备案", ES: "¿REQUIERE REGISTRO ANTE ECONOMÍA?" },
    fixedCharges: { EN: "FIXED CHARGES", ZH: "固定费用", ES: "CARGOS FIJOS" },
    contingentCharges: { EN: "CHARGES IF INCURRED", ZH: "发生才收取的费用", ES: "CARGOS SI SE GENERAN" },
    contingentHint: { EN: "For information only. These charges apply only if the stated event occurs and are excluded from this quotation subtotal.", ZH: "仅供提前告知。相应情况实际发生时才收取，不计入本次报价小计。", ES: "Solo informativos. Se cobran únicamente si ocurre la situación indicada y se excluyen del subtotal de esta cotización." },
    fixedHint: { EN: "Selected fixed charges for the agreed service. AT COST and price ranges remain subject to final confirmation and are excluded from the subtotal.", ZH: "已选定的服务固定费用。AT COST 及区间金额待最终确认，不计入小计。", ES: "Cargos fijos seleccionados del servicio acordado. Los conceptos AT COST y rangos de precio quedan pendientes de confirmación y se excluyen del subtotal." },
    ifIncurredAmount: { EN: "AMOUNT IF INCURRED", ZH: "发生时金额", ES: "IMPORTE SI OCURRE" },
    subtotalLabel: { EN: "FIXED SUBTOTAL", ZH: "固定费用小计", ES: "SUBTOTAL FIJO" },
    indicativeLabel: { EN: "Reference conversion only", ZH: "换汇金额仅供参考", ES: "Conversión solo como referencia" },
    noFixedAmount: { EN: "No confirmed fixed amount. AT COST, unconfirmed price ranges and charges if incurred are excluded.", ZH: "暂无已确认的固定金额；AT COST、待确认区间及或有费用不计入。", ES: "Sin importe fijo confirmado. Se excluyen AT COST, rangos pendientes y cargos si se generan." },
    secForeign: { EN: "NO MEXICO CHARGES", ZH: "境外 / 起运费用", ES: "CARGOS FUERA DE MÉXICO" },
    secMexico: { EN: "MEXICO LOCAL CHARGES", ZH: "墨西哥本地费用", ES: "CARGOS LOCALES MÉXICO" },
    colCat: { EN: "CHARGE CATEGORY", ZH: "费用类别", ES: "CATEGORÍA" },
    colCode: { EN: "INTERNAL CODE", ZH: "内部计费代码", ES: "CÓDIGO INTERNO" },
    internalCopy: { EN: "INTERNAL COPY", ZH: "内部版", ES: "COPIA INTERNA" },
    taxIncluded: { EN: "Entered prices include tax. No additional tax has been added.", ZH: "输入价格已含税，未重复加税。", ES: "Los precios incluyen impuestos. No se agregaron impuestos adicionales." },
    taxExcluded: { EN: "Entered prices exclude tax. Applicable tax is not included in these amounts.", ZH: "输入价格未含税，所示金额未加税。", ES: "Los precios no incluyen impuestos. Los impuestos aplicables no están incluidos." },
    colConcept: { EN: "CONCEPT", ZH: "费用", ES: "CONCEPTO" },
    colQty: { EN: "QTY", ZH: "数量", ES: "CANT." },
    colUom: { EN: "UNIT", ZH: "单位", ES: "UNIDAD" },
    colUnitPrice: { EN: "UNIT PRICE", ZH: "单价", ES: "PRECIO UNIT." },
    colTotal: { EN: "TOTAL PRICE", ZH: "金额", ES: "TOTAL" },
    colCur: { EN: "CURRENCY", ZH: "币种", ES: "MONEDA" },
    colRemark: { EN: "REMARKS", ZH: "备注", ES: "OBSERVACIONES" },
    notes: { EN: "NOTES", ZH: "备注", ES: "NOTAS" },
  };
  function L(key) { var m = LBL[key] || {}; return m[labelLang] || m.EN || key; }
  function bilingualLabel(key) { return single ? L(key) : L(key) + " / " + LBL[key].ZH; }
  function qualificationValue(value, isImporter) {
    var values = isImporter ? {
      own: { EN: "Customer's own import qualification", ZH: "客户自有进口资质", ES: "Padrón propio del cliente" },
      trading_company: { EN: "Import via a trading company", ZH: "借贸易公司进口", ES: "Importación mediante comercializadora" }
    } : {
      yes: { EN: "Yes", ZH: "是", ES: "Sí" },
      no: { EN: "No", ZH: "否", ES: "No" },
      unknown: { EN: "To be confirmed", ZH: "待确认", ES: "Por confirmar" }
    };
    var answer = values[value];
    if (!answer) return "—";
    return single ? answer[labelLang] : answer.EN + " / " + answer.ZH;
  }
  var UOM = {
    container: { EN: "container", ZH: "柜", ES: "contenedor" },
    bl: { EN: "BL", ZH: "提单", ES: "BL" },
    occurrence: { EN: "occurrence", ZH: "次", ES: "vez" },
    piece: { EN: "piece", ZH: "个", ES: "pieza" },
    vehicle: { EN: "vehicle", ZH: "车型", ES: "vehículo" },
    day: { EN: "day", ZH: "天", ES: "día" },
    chargeable: { EN: "chargeable unit", ZH: "计费单位", ES: "unidad facturable" },
    shipment: { EN: "shipment", ZH: "票", ES: "embarque" },
    truck: { EN: "truck", ZH: "车", ES: "camión" },
    kg: { EN: "kg", ZH: "千克", ES: "kg" },
    ton: { EN: "ton", ZH: "吨", ES: "tonelada" },
    cbm: { EN: "m³", ZH: "立方米", ES: "m³" },
    flat: { EN: "flat fee", ZH: "一口价", ES: "tarifa fija" },
  };
  function uomLabel(code) { var m = UOM[code]; return m ? (m[labelLang] || m.EN) : (code || ""); }
  function noteText(note) {
    if (qlang === "ZH") return note.zh || note.en || "";
    if (qlang === "ES") return note.es || note.en || "";
    return note.en || "";
  }
  var sectionList = (typeof sections !== "undefined" && sections && sections.length)
    ? sections
    : [{ section: "mexico", groups: (typeof groups !== "undefined" ? groups : []) }];
  var chargeList = (typeof chargeSections !== "undefined" && Array.isArray(chargeSections))
    ? chargeSections
    : [{ chargeKind: "fixed", sections: sectionList }];
  var card = typeof rateCard !== "undefined" && rateCard ? rateCard : {};
  var cardVariants = Array.isArray(card.variants) ? card.variants : [];
  var cardRows = (Array.isArray(card.rows) ? card.rows : []).filter((row) => row.included !== false);
  var variantPanels = [];
  for (var variantIndex = 0; variantIndex < cardVariants.length; variantIndex += 3) {
    variantPanels.push(cardVariants.slice(variantIndex, variantIndex + 3));
  }
  function rateLabel(cell) {
    if (!cell) return "—";
    if (cell.isAtCost) return "AT COST";
    if (typeof cell.priceLabel === "string") return cell.priceLabel;
    if (cell.unitPrice === null || cell.unitPrice === undefined || cell.unitPrice === "") return "—";
    var price = Number(cell.unitPrice);
    if (!Number.isFinite(price)) return "—";
    var numberFormat = { minimumFractionDigits: 2, maximumFractionDigits: 2 };
    var result = price.toLocaleString("en-US", numberFormat);
    if (cell.unitPriceMax !== null && cell.unitPriceMax !== undefined && cell.unitPriceMax !== "") {
      var max = Number(cell.unitPriceMax);
      if (Number.isFinite(max) && max !== price) result += "–" + max.toLocaleString("en-US", numberFormat);
    }
    return result;
  }
%>
  <header class="doc-header">
    <div class="logo-box">
      <% if (assets.logoExpressLine) { %><img src="<%= assets.logoExpressLine %>" alt="Express Line Corporation" /><% } else { %><div class="logo-ph">Express Line Corporation<br/>(logo pending)</div><% } %>
    </div>
    <% if (internal) { %><strong><%= bilingualLabel('internalCopy') %></strong><% } %>
  </header>

  <div class="quote-meta">
    <div><div class="lbl"><%= L("date") %></div><div><%= date %></div></div>
    <div><div class="lbl"><%= L("number") %></div><div><%= number %></div></div>
    <div><div class="lbl"><%= L("quoteType") %></div><div><%= bilingualLabel(longTerm ? "longTermQuote" : "singleQuote") %></div></div>
  </div>

  <div class="band"><%= L("general") %></div>
  <table class="general">
    <tr><td class="k"><%= L("operation") %></td><td><%= header.operation %></td><td class="k"><%= L("incoterm") %></td><td><%= header.incoterm %></td></tr>
    <tr><td class="k"><%= L("department") %></td><td><%= header.department %></td><td class="k"><%= L("transport") %></td><td><%= header.transportMode || "" %></td></tr>
    <tr><td class="k"><%= L("cargo") %></td><td><%= header.cargoTypeLabel || header.cargoType %></td><td class="k"><%= L("pol") %></td><td><%= header.pol %></td></tr>
    <tr><td class="k"><%= L("commodity") %></td><td><%= header.commodity %></td><td class="k"><%= L("pod") %></td><td><%= header.pod %></td></tr>
    <tr><td class="k"><%= L("delivery") %></td><td colspan="3"><%= header.delivery %></td></tr>
    <% ['importerQualification', 'specialImportQualification', 'nomCertification', 'ministryRegistration'].forEach((key) => { %>
      <tr><td class="k qualification-key" colspan="2"><%= bilingualLabel(key) %></td><td colspan="2"><%= qualificationValue(header[key], key === 'importerQualification') %></td></tr>
    <% }); %>
    <% (header.extraFields || []).forEach((f) => { %>
      <tr><td class="k"><%= f.label %></td><td colspan="3"><%= f.value %></td></tr>
    <% }); %>
  </table>

  <% if (longTerm) { %>
    <% variantPanels.forEach((panel, panelIndex) => { %>
    <div class="rate-card-panel" data-panel="<%= panelIndex + 1 %>">
      <% ['fixed', 'contingent'].forEach((kind) => {
        ['foreign', 'mexico'].forEach((geography) => {
          var rows = cardRows.filter((row) => (row.chargeKind === 'contingent' ? 'contingent' : 'fixed') === kind && (row.section === 'foreign' ? 'foreign' : 'mexico') === geography);
          if (!rows.length) return;
          var columnCount = (internal ? 7 : 6) + panel.length;
      %>
      <table class="charges rate-card">
        <colgroup>
          <col style="width:<%= internal ? 8 : 9 %>%" />
          <% if (internal) { %><col style="width:6%" /><% } %>
          <col style="width:<%= internal ? 18 : 20 %>%" />
          <col style="width:3%" />
          <col style="width:7%" />
          <% panel.forEach(() => { %><col style="width:<%= (internal ? 33 : 35) / panel.length %>%" /><% }); %>
          <col style="width:6%" />
          <col style="width:<%= internal ? 19 : 20 %>%" />
        </colgroup>
        <thead>
          <tr><td colspan="<%= columnCount %>" class="charge-heading-cell">
            <div class="band <%= kind === 'contingent' ? 'contingent-band' : '' %>"><%= bilingualLabel('longTermQuote') %><% if (variantPanels.length > 1) { %> · <%= panelIndex + 1 %> / <%= variantPanels.length %><% } %> · <%= bilingualLabel(kind === 'contingent' ? 'contingentCharges' : 'fixedCharges') %></div>
            <p class="charge-section-hint"><%= L('rateCardHint') %><% if (!single) { %><br/><span class="zh"><%= LBL.rateCardHint.ZH %></span><% } %><% if (kind === 'contingent') { %><br/><%= bilingualLabel('rateCardContingentHint') %><% } %></p>
            <div class="charge-section-label"><%= bilingualLabel(geography === 'foreign' ? 'secForeign' : 'secMexico') %></div>
          </td></tr>
          <tr>
            <th><%= L('colCat') %></th>
            <% if (internal) { %><th><%= L('colCode') %></th><% } %>
            <th><%= L('colConcept') %></th>
            <th><%= L('colQty') %></th>
            <th><%= L('colUom') %></th>
            <% panel.forEach((variant) => { %><th class="specification"><%= variant.label %><br/><%= L('colUnitPrice') %></th><% }); %>
            <th><%= L('colCur') %></th>
            <th><%= L('colRemark') %></th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach((row) => { %>
          <tr>
            <td class="cat"><%= row.category %></td>
            <% if (internal) { %><td><%= row.code || '' %></td><% } %>
            <td>
              <% if (single) { %>
                <div class="concept-en"><%= qlang === 'ZH' ? (row.conceptZh || row.conceptEn) : (qlang === 'ES' ? (row.conceptEs || row.conceptEn) : row.conceptEn) %></div>
              <% } else { %>
                <div class="concept-en"><%= row.conceptEn %></div>
                <% if (row.conceptZh) { %><div class="concept-zh zh"><%= row.conceptZh %></div><% } %>
              <% } %>
            </td>
            <td class="quantity">1</td>
            <td><%= uomLabel(row.unitOfMeasure) %></td>
            <% panel.forEach((variant) => { var cell = (row.cells || {})[variant.id]; %>
              <td class="num <%= cell && cell.isAtCost ? 'atcost' : '' %>"><%= rateLabel(cell) %></td>
            <% }); %>
            <td class="cur"><%= row.currency %></td>
            <td><%= row.remark || '' %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
      <% }); }); %>
    </div>
    <% }); %>
  <% } else { %>
  <% chargeList.forEach((charge) => {
      var contingent = charge.chargeKind === 'contingent';
      var chargeGeographies = (charge.sections || []).map((sec) => ({
        section: sec.section,
        groups: (sec.groups || []).map((group) => ({ ...group, items: (group.items || []).filter((row) => contingent || row.included !== false) })).filter((group) => group.items.length)
      })).filter((sec) => sec.groups.length);
      if (!chargeGeographies.length) return;
  %>
    <% chargeGeographies.forEach((sec, secIndex) => { %>
    <table class="charges">
      <thead>
        <%# Keep the section title, explanation, geography and column headings
            inside the same print header group so none can orphan before a row. %>
        <tr><td colspan="<%= internal ? 9 : 8 %>" class="charge-heading-cell">
          <% if (secIndex === 0) { %>
            <div class="band <%= contingent ? 'contingent-band' : '' %>"><%= bilingualLabel(contingent ? 'contingentCharges' : 'fixedCharges') %></div>
            <p class="charge-section-hint"><%= L(contingent ? 'contingentHint' : 'fixedHint') %><% if (!single) { %><br/><span class="zh"><%= LBL[contingent ? 'contingentHint' : 'fixedHint'].ZH %></span><% } %></p>
          <% } %>
          <div class="charge-section-label"><%= bilingualLabel(sec.section === 'foreign' ? 'secForeign' : 'secMexico') %></div>
        </td></tr>
        <tr>
          <th style="width:92px;"><%= L("colCat") %></th>
          <% if (internal) { %><th style="width:62px;"><%= L("colCode") %></th><% } %>
          <th><%= L("colConcept") %></th>
          <th style="width:30px;"><%= L("colQty") %></th>
          <th style="width:44px;"><%= L("colUom") %></th>
          <th style="width:78px;"><%= L("colUnitPrice") %></th>
          <th style="width:78px;"><%= L(contingent ? "ifIncurredAmount" : "colTotal") %></th>
          <th style="width:46px;"><%= L("colCur") %></th>
          <th style="width:140px;"><%= L("colRemark") %></th>
        </tr>
      </thead>
      <tbody>
        <% sec.groups.forEach((group) => { group.items.forEach((row, idx) => { %>
          <tr>
            <% if (idx === 0) { %><td class="cat" rowspan="<%= group.items.length %>"><%= group.category %></td><% } %>
            <% if (internal) { %><td style="overflow-wrap:anywhere;"><%= row.code || '' %></td><% } %>
            <td>
              <% if (single) { %>
                <div class="concept-en"><%= qlang === "ZH" ? (row.conceptZh || row.conceptEn) : (qlang === "ES" ? (row.conceptEs || row.conceptEn) : row.conceptEn) %></div>
              <% } else { %>
                <div class="concept-en"><%= row.conceptEn %></div>
                <% if (row.conceptZh) { %><div class="concept-zh zh"><%= row.conceptZh %></div><% } %>
              <% } %>
            </td>
            <td class="num"><%= row.unit === null ? "" : row.unit %></td>
            <td><%= uomLabel(row.unitOfMeasure) %></td>
            <td class="num <%= row.isAtCost ? 'atcost' : '' %>"><%= row.unitPriceLabel %></td>
            <td class="num <%= row.total === null ? 'atcost' : '' %>"><%= row.totalLabel %></td>
            <td class="cur"><%= row.currency %></td>
            <td><%= row.remark %></td>
          </tr>
        <% }); }); %>
        <% if (!sec.groups.length) { %><tr><td colspan="<%= internal ? 9 : 8 %>" class="atcost">—</td></tr><% } %>
      </tbody>
    </table>
    <% }); %>
  <% }); %>
  <% } %>

  <% if (typeof route !== "undefined" && route) { %>
    <div class="route-meta">
      <b>RUTA / ROUTE</b> <span class="zh">运输路线</span>:
      <%= route.originName %> → <%= route.destName %>
      <% if (route.distanceKm != null) { %> · ~<%= Number(route.distanceKm).toLocaleString("en-US") %> km<% } %>
      <% if (route.durationMin != null) { %> · ≈<%= Math.round(route.durationMin / 60) %> h<% } %>
      <% if (route.viaCities && route.viaCities.length) { %> · vía: <%= route.viaCities.join(", ") %><% } %>
      <% if (route.hasFerry) { %> · <span class="ferry">con ferry / 含轮渡</span><% } %>
    </div>
  <% } %>

  <% if (includeTotals) { %>
  <div class="subtotals">
    <% subtotals.forEach((s) => { %>
      <div><%= s.currency %> <%= L("subtotalLabel") %>: <b><%= s.amountLabel %> <%= s.currency %></b></div>
    <% }); %>
    <% if (!subtotals.length) { %><div class="atcost"><%= bilingualLabel("noFixedAmount") %></div><% } %>
  </div>
  <% if (typeof indicative !== 'undefined' && indicative) { %>
    <p class="indicative"><%= bilingualLabel('indicativeLabel') %>: <%= indicative.amountLabel %> <%= indicative.currency %><% if (indicative.asOfDate) { %> · <%= indicative.asOfDate %><% } %></p>
  <% } %>
  <% } %>
  <% if (tax === 'included' || tax === 'excluded') { %>
    <p class="subtotal-note"><%= bilingualLabel(tax === 'included' ? 'taxIncluded' : 'taxExcluded') %></p>
  <% } %>

  <div class="notes">
    <div class="band"><%= L("notes") %></div>
    <ol>
      <% notes.forEach((note) => { %>
        <% if (single) { %>
          <li><div<%= qlang === "ZH" ? ' class="zh"' : "" %>><%= noteText(note) %></div></li>
        <% } else { %>
          <li><div><%= note.en %></div><% if (note.zh) { %><div class="zh"><%= note.zh %></div><% } %></li>
        <% } %>
      <% }); %>
    </ol>
  </div>

  <footer class="doc-footer">
    <div class="brand">Express Line Corporation</div>
    <div class="marks">
      <% if (assets.logoIata) { %><img src="<%= assets.logoIata %>" alt="IATA" /><% } else { %><div class="mark-ph">IATA (logo pending)</div><% } %>
      <% if (assets.logoCtpat) { %><img src="<%= assets.logoCtpat %>" alt="C-TPAT" /><% } else { %><div class="mark-ph">C-TPAT (logo pending)</div><% } %>
    </div>
  </footer>
</body>
</html>
