{
  "name": "jose-expressline-consulting",
  "version": "1.0.0",
  "description": "Cost calculator and admin portal for shipping line release fees.",
  "main": "src/server.js",
  "scripts": {
    "build:data": "node scripts/normalize-data.js",
    "db:check": "node scripts/db-check.js",
    "db:migrate": "node scripts/db-migrate.js",
    "db:seed": "node scripts/db-seed.js",
    "dev": "node --watch src/server.js",
    "fx:refresh": "node scripts/refresh-exchange-rates.js",
    "inland:seed": "node scripts/seed-inland-from-csv.js",
    "inland:routes": "node scripts/refresh-inland-routes.js",
    "start": "node src/server.js",
    "templates:excel": "python3 scripts/generate_bulk_upload_templates.py",
    "test": "node scripts/smoke-test.js",
    "test:quote": "node scripts/quote-test.js",
    "test:all": "node scripts/run-all-tests.js"
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "pg": "^8.20.0",
    "puppeteer": "^24.15.0"
  },
  "engines": {
    "node": ">=20"
  }
}
